---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Verify your email — conference.contact">
  <div class="flex min-h-screen items-center justify-center bg-bg-soft px-6 py-16">
    <div class="w-full max-w-sm rounded-2xl bg-white p-8 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight text-navy">
        <svg viewBox="0 0 96 96" class="h-7 w-7 shrink-0" aria-hidden="true">
          <rect width="96" height="96" rx="26" fill="#C3DB42" />
          <rect x="16" y="26" width="64" height="44" rx="9" fill="#0D1448" />
          <circle cx="33" cy="44" r="8" fill="#C3DB42" />
          <path d="M 22 62 a 11 11 0 0 1 22 0 z" fill="#C3DB42" />
          <rect x="49" y="38" width="23" height="5.5" rx="2.75" fill="#C3DB42" />
          <rect x="49" y="49" width="16" height="5" rx="2.5" fill="#FFFFFF" opacity="0.85" />
          <circle cx="72" cy="66" r="13" fill="#C3DB42" />
          <path d="M 66.5 66 l 4 4 l 7.5 -8.5" stroke="#0D1448" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
        <span>conference<span class="text-lime">.</span>contact</span>
      </a>

      <div id="verify-pending" class="mt-8">
        <p class="text-[14px] text-ink-soft">Verifying your email…</p>
      </div>

      <div id="verify-success" hidden class="mt-8">
        <p class="text-[15px] font-semibold text-ink">Email verified</p>
        <p class="mt-2 text-[13px] leading-relaxed text-ink-soft">You can sign in now.</p>
        <a
          href="/signin"
          class="mt-6 block rounded-xl bg-navy py-3.5 text-center text-[15px] font-semibold text-white transition-colors hover:bg-navy-mid"
        >
          Sign in →
        </a>
      </div>

      <div id="verify-error" hidden class="mt-8">
        <p class="text-[15px] font-semibold text-ink">This link didn't work</p>
        <p id="verify-error-message" class="mt-2 text-[13px] leading-relaxed text-ink-soft">
          It may have expired or already been used.
        </p>
        <a
          href="/signin"
          class="mt-6 block rounded-xl bg-navy py-3.5 text-center text-[15px] font-semibold text-white transition-colors hover:bg-navy-mid"
        >
          Back to sign in
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { apiFetch, ApiError } from "../lib/api";

  const pendingState = document.querySelector<HTMLDivElement>("#verify-pending")!;
  const successState = document.querySelector<HTMLDivElement>("#verify-success")!;
  const errorState = document.querySelector<HTMLDivElement>("#verify-error")!;
  const errorMessage = document.querySelector<HTMLParagraphElement>("#verify-error-message")!;

  const token = new URLSearchParams(window.location.search).get("token");

  async function run() {
    if (!token) {
      errorMessage.textContent = "No verification token was provided.";
      pendingState.hidden = true;
      errorState.hidden = false;
      return;
    }

    try {
      await apiFetch<{ message: string }>("/auth/verify-email", {
        method: "POST",
        body: JSON.stringify({ token }),
      });
      pendingState.hidden = true;
      successState.hidden = false;
    } catch (err) {
      errorMessage.textContent =
        err instanceof ApiError ? err.message : "It may have expired or already been used.";
      pendingState.hidden = true;
      errorState.hidden = false;
    }
  }

  run();
</script>
