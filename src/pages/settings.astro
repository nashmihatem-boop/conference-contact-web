---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Wave from "../components/Wave.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Settings — conference.contact" noindex>
  <Nav />

  <div class="relative overflow-hidden bg-navy px-5 pb-16 pt-14 sm:px-8 sm:pt-20">
    <div class="navy-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl">
      <a href="/account" class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-white/60 transition-colors hover:text-white">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to account
      </a>
      <p class="text-[13px] font-semibold uppercase tracking-wide text-lime">Settings</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Profile</h1>
      <p class="mt-2 text-[14px] text-white/60">Manage your name, contact info, and directory listing.</p>
    </div>
  </div>
  <Wave before="var(--color-navy)" after="var(--color-bg-soft)" />

  <div class="bg-bg-soft px-5 pt-6 pb-14 sm:px-8 sm:pt-8">
    <div class="mx-auto flex max-w-2xl flex-col gap-5">
      <div id="settings-loading" class="rounded-2xl bg-white p-8 text-[14px] text-ink-soft shadow-[0_25px_60px_-30px_rgba(11,20,84,0.4)]">Loading…</div>

      <div id="settings-error" hidden class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>

      <form id="settings-form" hidden class="rounded-2xl bg-white p-7 shadow-[0_18px_45px_-30px_rgba(11,20,84,0.4)]">
        <p class="text-[13px] font-semibold uppercase tracking-wide text-ink-faint">Profile information</p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="first-name-input" class="mb-1.5 block text-[13px] font-semibold text-ink">First name</label>
            <input
              id="first-name-input"
              type="text"
              required
              maxlength="100"
              class="w-full rounded-xl border-2 border-line px-4 py-2.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
            />
          </div>
          <div>
            <label for="last-name-input" class="mb-1.5 block text-[13px] font-semibold text-ink">Last name</label>
            <input
              id="last-name-input"
              type="text"
              maxlength="100"
              class="w-full rounded-xl border-2 border-line px-4 py-2.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
            />
          </div>
        </div>

        <div class="mt-4">
          <label for="phone-input" class="mb-1.5 block text-[13px] font-semibold text-ink">Phone <span class="font-normal text-ink-faint">(optional)</span></label>
          <input
            id="phone-input"
            type="tel"
            maxlength="30"
            placeholder="+1 555 123 4567"
            class="w-full rounded-xl border-2 border-line px-4 py-2.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
          />
        </div>

        <div class="mt-4">
          <label class="mb-1.5 block text-[13px] font-semibold text-ink">Email address</label>
          <div class="flex items-center justify-between gap-3 rounded-xl border-2 border-line bg-bg-soft px-4 py-2.5">
            <span id="email-display" class="truncate text-[14px] text-ink-soft"></span>
            <span id="email-verified-badge" class="shrink-0 rounded-full bg-lime-tint px-2.5 py-1 text-[12px] font-medium text-navy">Verified</span>
          </div>
          <p class="mt-1.5 text-[12px] text-ink-faint">
            Need to change your email? <a href="/contact?reason=account_issue" class="font-semibold text-navy hover:text-navy-mid">Contact us</a>.
          </p>
        </div>

        <p id="settings-feedback" hidden class="mt-4 text-[13px]"></p>

        <button
          id="save-button"
          type="submit"
          class="mt-5 w-full rounded-full bg-navy py-3 text-center text-[14px] font-semibold text-white transition-colors hover:bg-navy-mid disabled:cursor-not-allowed disabled:opacity-60"
        >
          Save changes
        </button>
      </form>

      <!-- Full self-submit form now lives on its own page — /get-listed — so it can carry real marketing copy instead of being buried here. -->
      <a
        id="listing-section"
        href="/get-listed"
        hidden
        class="group flex items-center justify-between gap-4 rounded-2xl bg-white p-7 shadow-[0_18px_45px_-30px_rgba(11,20,84,0.4)] transition-all hover:-translate-y-0.5 hover:shadow-[0_22px_50px_-25px_rgba(11,20,84,0.4)]"
      >
        <div>
          <p class="text-[13px] font-semibold uppercase tracking-wide text-ink-faint">Directory listing</p>
          <h2 class="mt-1.5 font-display text-lg font-extrabold tracking-tight text-ink">Not in the directory yet?</h2>
          <p class="mt-1 text-[13px] text-ink-soft">Add yourself so subscribers searching your conference can find you.</p>
        </div>
        <span class="shrink-0 text-[13px] font-semibold text-navy transition-transform group-hover:translate-x-0.5">Get listed →</span>
      </a>
    </div>
  </div>
  <Footer />
</Layout>

<script>
  import { authFetch, ApiError } from "../lib/api";
  import { clearAccessToken, ensureAuthenticated, redirectToSignin } from "../lib/session";

  interface Profile {
    id: string;
    email: string;
    fullName: string;
    phone: string | null;
    emailVerified: boolean;
  }

  const loading = document.querySelector<HTMLDivElement>("#settings-loading")!;
  const errorBanner = document.querySelector<HTMLDivElement>("#settings-error")!;
  const form = document.querySelector<HTMLFormElement>("#settings-form")!;
  const firstNameInput = document.querySelector<HTMLInputElement>("#first-name-input")!;
  const lastNameInput = document.querySelector<HTMLInputElement>("#last-name-input")!;
  const phoneInput = document.querySelector<HTMLInputElement>("#phone-input")!;
  const emailDisplay = document.querySelector<HTMLSpanElement>("#email-display")!;
  const emailVerifiedBadge = document.querySelector<HTMLSpanElement>("#email-verified-badge")!;
  const feedback = document.querySelector<HTMLParagraphElement>("#settings-feedback")!;
  const saveButton = document.querySelector<HTMLButtonElement>("#save-button")!;

  const listingSection = document.querySelector<HTMLAnchorElement>("#listing-section")!;

  function handleError(err: unknown): void {
    loading.hidden = true;
    if (err instanceof ApiError && err.statusCode === 401) {
      clearAccessToken();
      redirectToSignin();
      return;
    }
    errorBanner.textContent =
      err instanceof ApiError ? err.message : "Something went wrong. Please try again.";
    errorBanner.hidden = false;
  }

  async function loadProfile(): Promise<void> {
    try {
      const profile = await authFetch<Profile>("/users/me");
      const [first, ...rest] = profile.fullName.trim().split(/\s+/);
      firstNameInput.value = first ?? "";
      lastNameInput.value = rest.join(" ");
      phoneInput.value = profile.phone ?? "";
      emailDisplay.textContent = profile.email;
      emailVerifiedBadge.textContent = profile.emailVerified ? "Verified" : "Not verified";
      emailVerifiedBadge.className = profile.emailVerified
        ? "shrink-0 rounded-full bg-lime-tint px-2.5 py-1 text-[12px] font-medium text-navy"
        : "shrink-0 rounded-full bg-red-50 px-2.5 py-1 text-[12px] font-medium text-red-600";

      loading.hidden = true;
      form.hidden = false;
      listingSection.hidden = false;
    } catch (err) {
      handleError(err);
    }
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    saveButton.disabled = true;
    saveButton.textContent = "Saving…";
    feedback.hidden = true;
    try {
      const fullName = [firstNameInput.value.trim(), lastNameInput.value.trim()]
        .filter(Boolean)
        .join(" ");
      await authFetch<Profile>("/users/me", {
        method: "PATCH",
        body: JSON.stringify({
          fullName,
          phone: phoneInput.value.trim() || undefined,
        }),
      });
      feedback.textContent = "Saved.";
      feedback.className = "mt-4 text-[13px] text-navy";
      feedback.hidden = false;
    } catch (err) {
      feedback.textContent =
        err instanceof ApiError ? err.message : "Couldn't save your changes. Please try again.";
      feedback.className = "mt-4 text-[13px] text-red-600";
      feedback.hidden = false;
    } finally {
      saveButton.disabled = false;
      saveButton.textContent = "Save changes";
    }
  });

  if (!(await ensureAuthenticated())) {
    redirectToSignin();
  } else {
    void loadProfile();
  }
</script>
