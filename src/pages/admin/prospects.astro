---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import AdminNav from "../../components/AdminNav.astro";
---

<Layout title="Admin · Prospects — conference.contact" noindex>
  <Nav />
  <AdminNav />

  <div class="mx-auto max-w-[1600px] px-5 py-10 sm:px-8">
    <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink">Prospects</h1>
    <p class="mt-1 text-[14px] text-ink-soft">Signed-up users without active Directory access — never subscribed, canceled, or overdue. Oldest signups first.</p>
    <p id="total-count" class="mt-1 text-[14px] text-ink-soft"></p>

    <div class="mt-6 rounded-2xl border border-line bg-white p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-[14px] font-semibold text-ink">Cold invite campaign</p>
          <p class="mt-1 text-[13px] text-ink-soft">Uploads queue here and go out in a daily-capped batch — a brand-new sending domain can't safely absorb a large blast at once. Re-checks unsubscribes and existing accounts again at send time.</p>
        </div>
        <div id="campaign-paused-badge" hidden class="whitespace-nowrap rounded-full bg-red-50 px-3 py-1 text-[12px] font-semibold text-red-700">Paused</div>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        <div class="rounded-xl border border-line bg-bg-soft p-3">
          <p class="text-[11px] uppercase tracking-wide text-ink-faint">Pending</p>
          <p id="stat-pending" class="mt-1 text-[20px] font-bold text-ink">—</p>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft p-3">
          <p class="text-[11px] uppercase tracking-wide text-ink-faint">Sent</p>
          <p id="stat-sent" class="mt-1 text-[20px] font-bold text-ink">—</p>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft p-3">
          <p class="text-[11px] uppercase tracking-wide text-ink-faint">Skipped</p>
          <p id="stat-skipped" class="mt-1 text-[20px] font-bold text-ink">—</p>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft p-3">
          <p class="text-[11px] uppercase tracking-wide text-ink-faint">Bounced</p>
          <p id="stat-bounced" class="mt-1 text-[20px] font-bold text-ink">—</p>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft p-3">
          <p class="text-[11px] uppercase tracking-wide text-ink-faint">Complained</p>
          <p id="stat-complained" class="mt-1 text-[20px] font-bold text-ink">—</p>
        </div>
        <div class="rounded-xl border border-line bg-bg-soft p-3">
          <p class="text-[11px] uppercase tracking-wide text-ink-faint">Bad rate</p>
          <p id="stat-bad-rate" class="mt-1 text-[20px] font-bold text-ink">—</p>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-end gap-3 border-t border-line pt-4">
        <div class="flex flex-col gap-1">
          <label for="daily-cap-input" class="text-[12px] font-medium text-ink-soft">Daily send cap</label>
          <input id="daily-cap-input" type="number" min="1" max="1000" class="w-28 rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
        </div>
        <button id="daily-cap-save" type="button" class="rounded-lg border border-line px-4 py-2 text-[13px] font-semibold text-navy transition-colors hover:border-navy">Save</button>
        <button id="campaign-pause-toggle" type="button" class="rounded-lg border border-line px-4 py-2 text-[13px] font-semibold text-navy transition-colors hover:border-navy">Pause</button>
        <button id="send-now-submit" type="button" class="rounded-lg bg-navy px-4 py-2 text-[13px] font-semibold text-white transition-colors hover:bg-navy-mid">Send now</button>
        <p id="campaign-settings-status" class="text-[13px]"></p>
      </div>
      <p id="send-now-status" class="text-[13px]"></p>

      <div class="mt-5 border-t border-line pt-4">
        <p class="text-[14px] font-semibold text-ink">Upload prospects</p>
        <p class="mt-1 text-[13px] text-ink-soft">CSV or paste — any column layout works, addresses are pulled out automatically. Queues into the daily drip above rather than sending immediately.</p>
        <div class="mt-3 flex flex-wrap items-start gap-4">
          <div class="flex flex-col gap-1">
            <label for="bulk-invite-file" class="text-[12px] font-medium text-ink-soft">Upload CSV</label>
            <input id="bulk-invite-file" type="file" accept=".csv,.txt,text/csv,text/plain" class="w-72 rounded-lg border border-line px-3 py-2 text-[13px] text-ink-soft focus:outline-none" />
          </div>
          <div class="flex flex-1 min-w-[260px] flex-col gap-1">
            <label for="bulk-invite-paste" class="text-[12px] font-medium text-ink-soft">…or paste emails (any format)</label>
            <textarea id="bulk-invite-paste" rows="4" placeholder="jane@company.com, john@company.com&#10;or one per line" class="w-full rounded-lg border border-line px-3 py-2 text-[13px] text-ink focus:outline-none"></textarea>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <p id="bulk-invite-preview" class="text-[13px] text-ink-soft">No emails detected yet.</p>
          <button id="bulk-invite-submit" type="button" disabled class="rounded-lg bg-lime px-4 py-2 text-[13px] font-bold text-navy-dark transition-colors hover:bg-lime-dark disabled:cursor-not-allowed disabled:opacity-50">Queue emails</button>
        </div>
        <p id="bulk-invite-status" class="mt-2 text-[13px]"></p>
      </div>

      <div class="mt-5 border-t border-line pt-4">
        <p class="text-[14px] font-semibold text-ink">Email template</p>
        <p class="mt-1 text-[13px] text-ink-soft">Edit the copy sent to every queued address — the preview updates as you type. The unsubscribe link and mailing address are fixed (legally required) and can't be changed here.</p>

        <div class="mt-3 grid gap-6 lg:grid-cols-2">
          <div class="flex flex-col gap-3">
            <div class="flex flex-col gap-1">
              <label for="template-subject" class="text-[12px] font-medium text-ink-soft">Subject</label>
              <input id="template-subject" type="text" maxlength="200" class="w-full rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
            </div>
            <div class="flex flex-col gap-1">
              <label for="template-heading" class="text-[12px] font-medium text-ink-soft">Heading</label>
              <input id="template-heading" type="text" maxlength="200" class="w-full rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
            </div>
            <div class="flex flex-col gap-1">
              <label for="template-body" class="text-[12px] font-medium text-ink-soft">Body</label>
              <textarea id="template-body" rows="4" maxlength="2000" class="w-full rounded-lg border border-line px-3 py-2 text-[13px] text-ink focus:outline-none"></textarea>
            </div>
            <div class="flex flex-col gap-1">
              <label for="template-cta" class="text-[12px] font-medium text-ink-soft">Button text</label>
              <input id="template-cta" type="text" maxlength="60" class="w-full rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
            </div>
            <div class="flex flex-col gap-1">
              <label for="template-footnote" class="text-[12px] font-medium text-ink-soft">Footnote</label>
              <input id="template-footnote" type="text" maxlength="300" class="w-full rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
            </div>
            <div class="flex flex-col gap-1">
              <label for="template-mailing-address" class="text-[12px] font-medium text-ink-soft">Mailing address</label>
              <input id="template-mailing-address" type="text" maxlength="300" class="w-full rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
              <p class="text-[11px] text-ink-faint">CAN-SPAM requires a real postal address on every commercial email — leave this filled in with a real one.</p>
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-3">
              <button id="template-save" type="button" class="rounded-lg bg-navy px-4 py-2 text-[13px] font-semibold text-white transition-colors hover:bg-navy-mid">Save template</button>
              <p id="template-save-status" class="text-[13px]"></p>
            </div>
          </div>

          <div>
            <div class="max-w-[420px] overflow-hidden rounded-2xl border border-line">
              <div class="border-b border-line bg-bg-soft px-4 py-2.5">
                <p id="preview-subject" class="text-[13px] font-semibold text-ink"></p>
                <p class="mt-0.5 text-[12px] text-ink-faint">From: conference.contact &lt;noreply@conference.contact&gt;</p>
              </div>
              <div style="background-color:#eeeef0;padding:28px 18px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                <div style="max-width:380px;margin:0 auto;">
                  <table role="presentation" style="margin:0 auto 22px;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td style="width:26px;height:26px;vertical-align:middle;">
                        <img src="https://www.conference.contact/icons/icon-64.png" width="26" height="26" alt="conference.contact" style="display:block;border-radius:7px;" />
                      </td>
                      <td style="padding-left:8px;font-size:16px;font-weight:800;color:#12152b;">conference<span style="color:#a9c022;">.</span>contact</td>
                    </tr>
                  </table>
                  <div style="background-color:#ffffff;border:1px solid #e2e2e7;border-radius:16px;padding:28px 22px;text-align:center;">
                    <h1 id="preview-heading" style="margin:0;font-size:18px;font-weight:800;color:#12152b;line-height:1.35;"></h1>
                    <p id="preview-body" style="margin:14px 0 0;font-size:14px;color:#5b5f73;line-height:1.6;"></p>
                    <a href="#" id="preview-cta" style="display:inline-block;margin-top:22px;background-color:#c6e02e;color:#0b1454;font-weight:700;font-size:14px;text-decoration:none;padding:12px 28px;border-radius:999px;"></a>
                    <p id="preview-footnote" style="margin:16px 0 0;font-size:12px;color:#9395a6;"></p>
                  </div>
                  <p style="text-align:center;margin-top:18px;font-size:11px;color:#9395a6;">conference.contact — the verified conference contact directory</p>
                  <p style="text-align:center;margin-top:10px;font-size:11px;color:#9395a6;"><a href="#" style="color:#9395a6;text-decoration:underline;">Unsubscribe</a> from emails like this.</p>
                  <p id="preview-mailing-address" style="text-align:center;margin-top:6px;font-size:10px;color:#b3b5c2;"></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-end gap-3 border-t border-line pt-4">
          <div class="flex flex-col gap-1">
            <label for="test-send-email" class="text-[12px] font-medium text-ink-soft">Send a real test to</label>
            <input id="test-send-email" type="email" autocomplete="off" placeholder="you@company.com" class="w-64 rounded-lg border border-line px-3 py-2 text-[14px] text-ink focus:outline-none" />
          </div>
          <button id="test-send-submit" type="button" class="rounded-lg border border-line px-4 py-2 text-[13px] font-semibold text-navy transition-colors hover:border-navy">Send test email</button>
        </div>
        <p class="mt-1.5 text-[12px] text-ink-faint">Test sends (and the real campaign) use the last <strong>saved</strong> template — save your edits first if you've changed anything above.</p>
        <p id="test-send-status" class="mt-2 text-[13px]"></p>
      </div>
    </div>

    <div id="admin-error" hidden class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>
    <div id="admin-loading" class="mt-6 text-[14px] text-ink-soft">Loading…</div>

    <div id="admin-content" hidden>
      <div class="flex flex-col gap-2 rounded-t-2xl border border-b-0 border-line bg-white p-3 sm:flex-row sm:items-center">
        <div class="flex flex-1 items-center gap-2 rounded-lg border border-line bg-white px-3 py-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-ink-faint">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
            <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            id="search-input"
            type="text"
            autocomplete="off"
            placeholder="Search by email or name…"
            class="w-full text-[14px] text-ink placeholder:text-ink-faint focus:outline-none"
          />
        </div>
      </div>

      <div class="overflow-x-auto rounded-b-2xl border border-line bg-white">
        <table class="w-full min-w-[860px] border-collapse text-left">
          <thead>
            <tr class="border-b border-line bg-white text-[11px] uppercase tracking-wide text-ink-faint">
              <th class="px-4 py-3 font-semibold">User</th>
              <th class="px-4 py-3 font-semibold">Signed up</th>
              <th class="px-4 py-3 font-semibold">Days since signup</th>
              <th class="px-4 py-3 font-semibold">Last login</th>
              <th class="px-4 py-3 font-semibold">Canceled</th>
              <th class="px-4 py-3 font-semibold">Paid</th>
              <th class="px-4 py-3 font-semibold">Overdue</th>
              <th class="px-4 py-3 font-semibold">Send a pitch</th>
            </tr>
          </thead>
          <tbody id="results-body"></tbody>
        </table>
      </div>

      <div class="mt-4 flex items-center justify-center gap-3 text-[13px] text-ink-soft">
        <button id="prev-page" type="button" class="rounded-lg border border-line px-3 py-1.5 font-medium text-ink transition-colors hover:border-ink-faint disabled:cursor-not-allowed disabled:opacity-40">
          ← Previous
        </button>
        <span id="page-indicator">Page 1</span>
        <button id="next-page" type="button" class="rounded-lg border border-line px-3 py-1.5 font-medium text-ink transition-colors hover:border-ink-faint disabled:cursor-not-allowed disabled:opacity-40">
          Next →
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { authFetch } from "../../lib/api";
  import { escapeHtml, formatDate, handleAdminError, requireSignedIn } from "../../lib/admin";

  interface Prospect {
    id: string;
    email: string;
    fullName: string;
    createdAt: string;
    lastLoginAt: string | null;
    daysSinceSignup: number;
    canceled: boolean;
    paid: boolean;
    overdue: boolean;
  }
  interface ProspectsPage {
    data: Prospect[];
    page: number;
    pageSize: number;
    total: number;
  }
  interface CampaignStats {
    pending: number;
    sent: number;
    skippedExistingUser: number;
    skippedUnsubscribed: number;
    bounced: number;
    complained: number;
    total: number;
    bounceComplaintRate: number;
    dailyCap: number;
    paused: boolean;
  }

  const PAGE_SIZE = 25;
  const TEMPLATES: { value: string; label: string }[] = [
    { value: "INTRO", label: "Intro" },
    { value: "VALUE", label: "Value" },
    { value: "URGENCY", label: "Urgency" },
  ];

  const loading = document.querySelector<HTMLDivElement>("#admin-loading")!;
  const errorBanner = document.querySelector<HTMLDivElement>("#admin-error")!;
  const content = document.querySelector<HTMLDivElement>("#admin-content")!;
  const totalCount = document.querySelector<HTMLParagraphElement>("#total-count")!;
  const searchInput = document.querySelector<HTMLInputElement>("#search-input")!;
  const resultsBody = document.querySelector<HTMLTableSectionElement>("#results-body")!;
  const prevButton = document.querySelector<HTMLButtonElement>("#prev-page")!;
  const nextButton = document.querySelector<HTMLButtonElement>("#next-page")!;
  const pageIndicator = document.querySelector<HTMLSpanElement>("#page-indicator")!;

  let currentPage = 1;
  let searchDebounce: ReturnType<typeof setTimeout> | undefined;

  function currentFilters(): URLSearchParams {
    const params = new URLSearchParams();
    if (searchInput.value.trim()) params.set("search", searchInput.value.trim());
    return params;
  }

  function rowHtml(prospect: Prospect): string {
    const pitchButtons = TEMPLATES.map(
      (t) =>
        `<button type="button" data-pitch="${t.value}" data-id="${escapeHtml(prospect.id)}" class="rounded-lg border border-line px-2.5 py-1 text-[12px] font-medium text-navy transition-colors hover:border-navy hover:bg-bg-soft">${t.label}</button>`,
    ).join("");

    return `
      <tr class="border-b border-line last:border-b-0 align-top">
        <td class="px-4 py-3">
          <p class="text-[14px] font-semibold text-ink">${escapeHtml(prospect.fullName)}</p>
          <a href="mailto:${escapeHtml(prospect.email)}" class="text-[12px] text-navy hover:text-navy-mid">${escapeHtml(prospect.email)}</a>
        </td>
        <td class="px-4 py-3 text-[13px] text-ink-soft whitespace-nowrap">${formatDate(prospect.createdAt)}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft">${prospect.daysSinceSignup}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft whitespace-nowrap">${formatDate(prospect.lastLoginAt)}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft">${prospect.canceled ? "Yes" : "No"}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft">${prospect.paid ? "Yes" : "No"}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft">${prospect.overdue ? "Yes" : "No"}</td>
        <td class="px-4 py-3">
          <div class="flex flex-wrap items-center gap-1.5">
            ${pitchButtons}
            <span data-pitch-status="${escapeHtml(prospect.id)}" class="text-[12px] text-ink-faint"></span>
          </div>
        </td>
      </tr>`;
  }

  function renderRows(prospects: Prospect[]): void {
    if (prospects.length === 0) {
      resultsBody.innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-[13px] text-ink-faint">No prospects match these filters — everyone here has active Directory access or hasn't signed up yet.</td></tr>`;
      return;
    }
    resultsBody.innerHTML = prospects.map(rowHtml).join("");
    resultsBody.querySelectorAll<HTMLButtonElement>("[data-pitch]").forEach((button) => {
      button.addEventListener("click", () => void handlePitch(button));
    });
  }

  async function handlePitch(button: HTMLButtonElement): Promise<void> {
    const id = button.dataset.id!;
    const template = button.dataset.pitch!;
    const status = resultsBody.querySelector<HTMLSpanElement>(`[data-pitch-status="${id}"]`)!;
    const row = button.closest("tr")!;
    const allButtons = row.querySelectorAll<HTMLButtonElement>("[data-pitch]");
    allButtons.forEach((b) => (b.disabled = true));
    status.textContent = "Sending…";
    status.className = "text-[12px] text-ink-soft";
    try {
      await authFetch(`/admin/prospects/${id}/pitch`, {
        method: "POST",
        body: JSON.stringify({ template }),
      });
      status.textContent = "Sent.";
      status.className = "text-[12px] text-navy";
    } catch (err) {
      status.textContent = "";
      handleAdminError(err, errorBanner);
    } finally {
      allButtons.forEach((b) => (b.disabled = false));
    }
  }

  async function loadPage(page: number): Promise<void> {
    currentPage = page;
    const params = currentFilters();
    params.set("page", String(page));
    params.set("pageSize", String(PAGE_SIZE));

    try {
      const result = await authFetch<ProspectsPage>(`/admin/prospects?${params.toString()}`);
      renderRows(result.data);
      pageIndicator.textContent = `Page ${result.page} of ${Math.max(1, Math.ceil(result.total / PAGE_SIZE))}`;
      prevButton.disabled = result.page <= 1;
      nextButton.disabled = result.page * PAGE_SIZE >= result.total;
      totalCount.textContent = `${result.total.toLocaleString()} prospect${result.total === 1 ? "" : "s"}.`;
    } catch (err) {
      handleAdminError(err, errorBanner);
    }
  }

  searchInput.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => loadPage(1), 350);
  });
  prevButton.addEventListener("click", () => loadPage(currentPage - 1));
  nextButton.addEventListener("click", () => loadPage(currentPage + 1));

  // ── Cold invite campaign ────────────────────────────────────────────

  const statPending = document.querySelector<HTMLParagraphElement>("#stat-pending")!;
  const statSent = document.querySelector<HTMLParagraphElement>("#stat-sent")!;
  const statSkipped = document.querySelector<HTMLParagraphElement>("#stat-skipped")!;
  const statBounced = document.querySelector<HTMLParagraphElement>("#stat-bounced")!;
  const statComplained = document.querySelector<HTMLParagraphElement>("#stat-complained")!;
  const statBadRate = document.querySelector<HTMLParagraphElement>("#stat-bad-rate")!;
  const pausedBadge = document.querySelector<HTMLDivElement>("#campaign-paused-badge")!;
  const dailyCapInput = document.querySelector<HTMLInputElement>("#daily-cap-input")!;
  const dailyCapSave = document.querySelector<HTMLButtonElement>("#daily-cap-save")!;
  const pauseToggle = document.querySelector<HTMLButtonElement>("#campaign-pause-toggle")!;
  const settingsStatus = document.querySelector<HTMLParagraphElement>("#campaign-settings-status")!;

  let campaignPaused = false;

  async function loadCampaignStats(): Promise<void> {
    try {
      const stats = await authFetch<CampaignStats>("/admin/prospects/campaign/stats");
      statPending.textContent = stats.pending.toLocaleString();
      statSent.textContent = stats.sent.toLocaleString();
      statSkipped.textContent = (stats.skippedExistingUser + stats.skippedUnsubscribed).toLocaleString();
      statBounced.textContent = stats.bounced.toLocaleString();
      statComplained.textContent = stats.complained.toLocaleString();
      statBadRate.textContent = `${(stats.bounceComplaintRate * 100).toFixed(1)}%`;
      statBadRate.className = `mt-1 text-[20px] font-bold ${stats.bounceComplaintRate > 0.03 ? "text-red-600" : "text-ink"}`;
      dailyCapInput.value = String(stats.dailyCap);
      campaignPaused = stats.paused;
      pausedBadge.hidden = !stats.paused;
      pauseToggle.textContent = stats.paused ? "Resume" : "Pause";
    } catch (err) {
      handleAdminError(err, errorBanner);
    }
  }

  dailyCapSave.addEventListener("click", async () => {
    const value = Number(dailyCapInput.value);
    if (!Number.isFinite(value) || value < 1) {
      settingsStatus.textContent = "Enter a valid daily cap.";
      settingsStatus.className = "text-[13px] text-red-600";
      return;
    }
    dailyCapSave.disabled = true;
    try {
      await authFetch("/admin/prospects/campaign/settings", {
        method: "PATCH",
        body: JSON.stringify({ dailyCap: value }),
      });
      settingsStatus.textContent = "Saved.";
      settingsStatus.className = "text-[13px] text-navy";
    } catch (err) {
      settingsStatus.textContent = "";
      handleAdminError(err, errorBanner);
    } finally {
      dailyCapSave.disabled = false;
    }
  });

  pauseToggle.addEventListener("click", async () => {
    pauseToggle.disabled = true;
    try {
      const result = await authFetch<{ dailyCap: number; paused: boolean }>(
        "/admin/prospects/campaign/settings",
        { method: "PATCH", body: JSON.stringify({ paused: !campaignPaused }) },
      );
      campaignPaused = result.paused;
      pausedBadge.hidden = !result.paused;
      pauseToggle.textContent = result.paused ? "Resume" : "Pause";
    } catch (err) {
      handleAdminError(err, errorBanner);
    } finally {
      pauseToggle.disabled = false;
    }
  });

  const sendNowSubmit = document.querySelector<HTMLButtonElement>("#send-now-submit")!;
  const sendNowStatus = document.querySelector<HTMLParagraphElement>("#send-now-status")!;

  sendNowSubmit.addEventListener("click", async () => {
    // A cap typed into the box but never explicitly saved would otherwise
    // still be sitting there unused — "Send now" would silently fall back
    // to whatever was last saved (possibly a much higher number from
    // earlier) instead of what's actually showing on screen. Saving first,
    // every time, means what you see here is always what happens.
    const capValue = Number(dailyCapInput.value);
    if (!Number.isFinite(capValue) || capValue < 1) {
      sendNowStatus.textContent = "Enter a valid daily cap before sending.";
      sendNowStatus.className = "text-[13px] text-red-600";
      return;
    }
    sendNowSubmit.disabled = true;
    sendNowStatus.textContent = "Saving daily cap…";
    sendNowStatus.className = "text-[13px] text-ink-soft";
    try {
      await authFetch("/admin/prospects/campaign/settings", {
        method: "PATCH",
        body: JSON.stringify({ dailyCap: capValue }),
      });
      settingsStatus.textContent = "Saved.";
      settingsStatus.className = "text-[13px] text-navy";
    } catch (err) {
      sendNowStatus.textContent = "";
      handleAdminError(err, errorBanner);
      sendNowSubmit.disabled = false;
      return;
    }

    sendNowStatus.textContent = "Sending…";
    sendNowStatus.className = "text-[13px] text-ink-soft";
    try {
      const result = await authFetch<{
        sent: number;
        skippedExisting: number;
        skippedUnsubscribed: number;
        batchSize: number;
      }>("/admin/prospects/campaign/send-now", { method: "POST" });
      sendNowStatus.textContent =
        result.batchSize === 0
          ? "Nothing to send — campaign is paused or the queue is empty."
          : `Sent ${result.sent.toLocaleString()} of ${result.batchSize.toLocaleString()} — ${(result.skippedExisting + result.skippedUnsubscribed).toLocaleString()} skipped.`;
      sendNowStatus.className = "text-[13px] text-navy";
      await loadCampaignStats();
    } catch (err) {
      sendNowStatus.textContent = "";
      handleAdminError(err, errorBanner);
    } finally {
      sendNowSubmit.disabled = false;
    }
  });

  const bulkInviteFile = document.querySelector<HTMLInputElement>("#bulk-invite-file")!;
  const bulkInvitePaste = document.querySelector<HTMLTextAreaElement>("#bulk-invite-paste")!;
  const bulkInvitePreview = document.querySelector<HTMLParagraphElement>("#bulk-invite-preview")!;
  const bulkInviteSubmit = document.querySelector<HTMLButtonElement>("#bulk-invite-submit")!;
  const bulkInviteStatus = document.querySelector<HTMLParagraphElement>("#bulk-invite-status")!;

  // Deliberately not a full CSV parser — a broad email regex pulls valid-
  // looking addresses out of whatever text it's given, so any column
  // layout, delimiter, or header row in a real-world export just works
  // without the admin needing to know which column has the email.
  const EMAIL_PATTERN = /[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+/g;

  let bulkInviteFileText = "";
  let bulkInviteEmails: string[] = [];

  function extractEmails(text: string): string[] {
    const matches = text.match(EMAIL_PATTERN) ?? [];
    return [...new Set(matches.map((e) => e.trim().toLowerCase()))];
  }

  function refreshBulkInvitePreview(): void {
    const combined = `${bulkInviteFileText}\n${bulkInvitePaste.value}`;
    bulkInviteEmails = extractEmails(combined);
    if (bulkInviteEmails.length === 0) {
      bulkInvitePreview.textContent = "No emails detected yet.";
      bulkInvitePreview.className = "text-[13px] text-ink-soft";
    } else {
      bulkInvitePreview.textContent = `${bulkInviteEmails.length.toLocaleString()} unique email${bulkInviteEmails.length === 1 ? "" : "s"} detected.`;
      bulkInvitePreview.className = "text-[13px] text-navy font-medium";
    }
    bulkInviteSubmit.disabled = bulkInviteEmails.length === 0;
  }

  bulkInviteFile.addEventListener("change", async () => {
    const file = bulkInviteFile.files?.[0];
    bulkInviteFileText = file ? await file.text() : "";
    refreshBulkInvitePreview();
  });
  bulkInvitePaste.addEventListener("input", refreshBulkInvitePreview);

  bulkInviteSubmit.addEventListener("click", async () => {
    if (bulkInviteEmails.length === 0) return;
    bulkInviteSubmit.disabled = true;
    bulkInviteStatus.textContent = `Queuing ${bulkInviteEmails.length.toLocaleString()} emails…`;
    bulkInviteStatus.className = "mt-2 text-[13px] text-ink-soft";
    try {
      const result = await authFetch<{
        queued: number;
        alreadyQueued: number;
        alreadyHasAccount: number;
        unsubscribed: number;
        invalid: number;
        total: number;
      }>("/admin/prospects/invite-bulk", {
        method: "POST",
        body: JSON.stringify({ emails: bulkInviteEmails }),
      });
      bulkInviteStatus.textContent = `Queued ${result.queued.toLocaleString()} of ${result.total.toLocaleString()} — ${result.alreadyQueued.toLocaleString()} already queued, ${result.alreadyHasAccount.toLocaleString()} already have accounts, ${result.unsubscribed.toLocaleString()} unsubscribed, ${result.invalid.toLocaleString()} invalid.`;
      bulkInviteStatus.className = "mt-2 text-[13px] text-navy";
      bulkInviteFile.value = "";
      bulkInvitePaste.value = "";
      bulkInviteFileText = "";
      bulkInviteEmails = [];
      refreshBulkInvitePreview();
      await loadCampaignStats();
    } catch (err) {
      bulkInviteStatus.textContent = "";
      handleAdminError(err, errorBanner);
    } finally {
      bulkInviteSubmit.disabled = bulkInviteEmails.length === 0;
    }
  });

  interface EmailTemplate {
    subject: string;
    heading: string;
    body: string;
    ctaLabel: string;
    footnote: string;
    mailingAddress: string;
  }

  const templateSubject = document.querySelector<HTMLInputElement>("#template-subject")!;
  const templateHeading = document.querySelector<HTMLInputElement>("#template-heading")!;
  const templateBody = document.querySelector<HTMLTextAreaElement>("#template-body")!;
  const templateCta = document.querySelector<HTMLInputElement>("#template-cta")!;
  const templateFootnote = document.querySelector<HTMLInputElement>("#template-footnote")!;
  const templateMailingAddress = document.querySelector<HTMLInputElement>("#template-mailing-address")!;
  const templateSave = document.querySelector<HTMLButtonElement>("#template-save")!;
  const templateSaveStatus = document.querySelector<HTMLParagraphElement>("#template-save-status")!;

  const previewSubject = document.querySelector<HTMLParagraphElement>("#preview-subject")!;
  const previewHeading = document.querySelector<HTMLHeadingElement>("#preview-heading")!;
  const previewBody = document.querySelector<HTMLParagraphElement>("#preview-body")!;
  const previewCta = document.querySelector<HTMLAnchorElement>("#preview-cta")!;
  const previewFootnote = document.querySelector<HTMLParagraphElement>("#preview-footnote")!;
  const previewMailingAddress = document.querySelector<HTMLParagraphElement>("#preview-mailing-address")!;

  function refreshTemplatePreview(): void {
    previewSubject.textContent = templateSubject.value;
    previewHeading.textContent = templateHeading.value;
    previewBody.textContent = templateBody.value;
    previewCta.textContent = templateCta.value;
    previewFootnote.textContent = templateFootnote.value;
    previewMailingAddress.textContent = templateMailingAddress.value;
  }
  [templateSubject, templateHeading, templateBody, templateCta, templateFootnote, templateMailingAddress].forEach((el) =>
    el.addEventListener("input", refreshTemplatePreview),
  );

  async function loadEmailTemplate(): Promise<void> {
    const template = await authFetch<EmailTemplate>("/admin/prospects/campaign/template");
    templateSubject.value = template.subject;
    templateHeading.value = template.heading;
    templateBody.value = template.body;
    templateCta.value = template.ctaLabel;
    templateFootnote.value = template.footnote;
    templateMailingAddress.value = template.mailingAddress;
    refreshTemplatePreview();
  }

  templateSave.addEventListener("click", async () => {
    templateSave.disabled = true;
    templateSaveStatus.textContent = "Saving…";
    templateSaveStatus.className = "text-[13px] text-ink-soft";
    try {
      await authFetch<EmailTemplate>("/admin/prospects/campaign/template", {
        method: "PATCH",
        body: JSON.stringify({
          subject: templateSubject.value,
          heading: templateHeading.value,
          body: templateBody.value,
          ctaLabel: templateCta.value,
          footnote: templateFootnote.value,
          mailingAddress: templateMailingAddress.value,
        }),
      });
      templateSaveStatus.textContent = "Saved — this is now what sends.";
      templateSaveStatus.className = "text-[13px] text-navy";
    } catch (err) {
      templateSaveStatus.textContent = "";
      handleAdminError(err, errorBanner);
    } finally {
      templateSave.disabled = false;
    }
  });

  const testSendEmail = document.querySelector<HTMLInputElement>("#test-send-email")!;
  const testSendSubmit = document.querySelector<HTMLButtonElement>("#test-send-submit")!;
  const testSendStatus = document.querySelector<HTMLParagraphElement>("#test-send-status")!;

  testSendSubmit.addEventListener("click", async () => {
    const email = testSendEmail.value.trim();
    if (!email) {
      testSendStatus.textContent = "Enter an email first.";
      testSendStatus.className = "mt-2 text-[13px] text-red-600";
      return;
    }
    testSendSubmit.disabled = true;
    testSendStatus.textContent = "Sending…";
    testSendStatus.className = "mt-2 text-[13px] text-ink-soft";
    try {
      const result = await authFetch<{ message: string }>("/admin/prospects/campaign/test-send", {
        method: "POST",
        body: JSON.stringify({ email }),
      });
      testSendStatus.textContent = result.message;
      testSendStatus.className = "mt-2 text-[13px] text-navy";
    } catch (err) {
      testSendStatus.textContent = "";
      handleAdminError(err, errorBanner);
    } finally {
      testSendSubmit.disabled = false;
    }
  });

  async function init(): Promise<void> {
    if (!(await requireSignedIn())) return;
    try {
      await Promise.all([loadPage(1), loadCampaignStats(), loadEmailTemplate()]);
      loading.hidden = true;
      content.hidden = false;
    } catch (err) {
      loading.hidden = true;
      handleAdminError(err, errorBanner);
    }
  }

  init();
</script>
