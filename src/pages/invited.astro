---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SearchDemo from "../components/SearchDemo.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Wave from "../components/Wave.astro";

// Same data as Pricing.astro's "What conference.contact replaces" section —
// duplicated rather than imported since that component's cards are styled
// for a white/bg-soft section, and these need to sit on the hero's navy
// background instead.
const savings = [
  {
    label: "Flights",
    tag: "Never book one.",
    icon: '<path d="M10.5 20 8 14M10.5 20l2.5-1.5M8 14 3 12.5 4.5 11 8 12l4.8-4.8c1-1 2.6-1 3.6 0 1 1 1 2.6 0 3.6L11.6 15l1 4.5-1.5 1.5-2.6-4M8 14l4.6-4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Hotels",
    tag: "Never check in.",
    icon: '<path d="M3 20V7a1 1 0 0 1 1-1h3v14M3 20h18M7 20V6M11 20v-6a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v6M9 10h1M9 13h1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Transportation",
    tag: "Never rent one.",
    icon: '<path d="M5 16.5V13l1.6-4.3A2 2 0 0 1 8.5 7.5h7a2 2 0 0 1 1.9 1.2L19 13v3.5M5 16.5a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5M5 16.5H3M19 16.5a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5m4.5 0H21M7 13h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Food",
    tag: "Never expense it.",
    icon: '<path d="M6 3v7a2 2 0 0 0 4 0V3M8 10v11M17 3c-1.7 0-3 2-3 5s1.3 5 3 5v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---

<Layout
  title="You're invited — conference.contact"
  description="You've been personally invited to check out the verified conference contact directory."
  noindex
>
  <Nav />

  <section class="relative overflow-hidden bg-navy px-5 pt-16 pb-20 sm:px-8 sm:pt-24 sm:pb-28">
    <div class="navy-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-2xl text-center">
      <p class="text-[13px] font-semibold uppercase tracking-wide text-lime">Personal invite</p>
      <h1 class="mt-3 font-display text-[2.25rem] font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl">
        You've been invited to see<br class="hidden sm:block" />
        <span class="text-lime">conference.contact</span>
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-[16px] leading-relaxed text-white/70">
        A hand-verified directory of who actually shows up to the B2B
        conference circuit, plus an AI tool that finds and enriches new leads
        live. Take a look below — no obligation, no sales call.
      </p>

      <a
        id="invited-cta"
        href="/signup"
        class="mt-8 inline-block rounded-full bg-lime px-8 py-3.5 text-[14px] font-semibold text-navy-dark transition-colors hover:bg-lime-dark"
      >
        Create your free account →
      </a>
      <p class="mt-3 text-[13px] text-white/50">
        Already have an account? <a href="/signin" class="text-lime hover:text-lime-dark">Sign in</a>
      </p>

      <p class="mt-10 text-[13px] font-semibold uppercase tracking-wide text-white/40">What conference.contact replaces</p>
      <div class="mx-auto mt-4 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4">
        {
          savings.map((item) => (
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 text-center backdrop-blur-sm">
              <span
                class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-lime-tint text-navy"
                set:html={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none">${item.icon}</svg>`}
              />
              <p class="mt-3 text-[13px] font-bold text-white">{item.label}</p>
              <p class="mt-0.5 text-[11px] text-white/60">{item.tag}</p>
              <p class="mt-2 font-display text-lg font-extrabold text-lime">$0</p>
            </div>
          ))
        }
      </div>

      <p class="mx-auto mt-6 max-w-lg text-[13px] leading-relaxed text-white/60">
        <span class="font-bold text-lime">24,931</span> verified contacts across{" "}
        <span class="font-bold text-lime">10</span> major B2B conferences —
        including Affiliate Summit East/West, Leadscon, and MAU Vegas.
      </p>
    </div>
  </section>
  <Wave before="var(--color-navy)" after="var(--color-bg-soft)" />

  <SearchDemo />
  <Features />

  <Footer />
</Layout>

<script>
  // Arrives from a prospect-invite email (see AdminService.inviteProspect),
  // which always builds this page's link as /invited?email=... — carrying
  // that straight through to signup means one less field for them to type,
  // and the account they create matches the address the invite went to.
  const email = new URLSearchParams(window.location.search).get("email");
  const cta = document.querySelector<HTMLAnchorElement>("#invited-cta");
  if (email && cta) {
    cta.href = `/signup?email=${encodeURIComponent(email)}`;
  }
</script>
