  function customCardHtml(): string {
    return `
      <div class="rounded-2xl border-2 border-line p-5">
        <p class="text-[13px] font-semibold text-ink-faint">Custom</p>
        <p class="mt-2 font-display text-2xl font-extrabold text-ink">Let's talk</p>
        <p class="mt-1 text-[12px] text-ink-faint">Tailored enterprise volume — high-volume or bespoke lead sourcing, priced to your needs.</p>
