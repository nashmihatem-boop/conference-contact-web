      ? `<span class="font-display text-3xl font-extrabold text-ink">Free</span>`
      : `<span class="font-display text-3xl font-extrabold text-ink">${formatUsd(tier.amountCents)}</span><span class="text-[13px] text-ink-soft">/mo</span>`;
    const subline = isFree
      ? `${tier.credits.toLocaleString()} leads, one-time`
