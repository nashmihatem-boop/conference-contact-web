---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Wave from "../components/Wave.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Lead Finder — conference.contact" noindex>
  <Nav />

  <div class="relative overflow-hidden bg-navy px-5 pb-20 pt-14 sm:px-8 sm:pt-20">
    <div class="navy-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl">
      <a href="/account" class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-white/60 transition-colors hover:text-white">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to account
      </a>
      <p class="text-[13px] font-semibold uppercase tracking-wide text-lime">AI Lead Finder</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Who are you looking for?</h1>
      <p class="mt-2 max-w-xl text-[14px] text-white/60">
        Describe a role or a company to find similar people — or give a specific person's name to look them up directly. We search the web live and enrich real contact details.
      </p>

      <div class="mt-6 max-w-sm rounded-xl border border-white/15 bg-white/5 px-4 py-3 backdrop-blur-sm">
        <div class="flex items-center justify-between text-[13px]">
          <span id="credits-label" class="font-medium text-white">— credits remaining</span>
          <button
            id="buy-credits-toggle"
            type="button"
            class="flex items-center gap-1 whitespace-nowrap rounded-full bg-white/10 px-2.5 py-1 text-[12px] font-semibold text-lime transition-colors hover:bg-white/20"
          >
            + Buy more
          </button>
        </div>

        <div id="buy-credits-panel" hidden class="mt-3 flex items-center justify-between gap-3 border-t border-white/10 pt-3">
          <div class="flex items-center gap-2">
            <button id="pack-qty-minus" type="button" class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 disabled:cursor-not-allowed disabled:opacity-40">−</button>
            <span id="pack-qty-label" class="min-w-[92px] text-center text-[12px] text-white/80">…</span>
            <button id="pack-qty-plus" type="button" class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20">+</button>
          </div>
          <button
            id="buy-credits-button"
            type="button"
            class="whitespace-nowrap rounded-full bg-lime px-4 py-2 text-[12px] font-semibold text-navy-dark transition-colors hover:bg-lime-dark disabled:cursor-not-allowed disabled:opacity-60"
          >
            Buy →
          </button>
        </div>
      </div>

      <div id="credits-banner" hidden class="mt-4 max-w-sm rounded-xl border border-lime/30 bg-white/5 px-4 py-2.5 text-[13px] text-lime backdrop-blur-sm"></div>
      <div id="free-tier-notice" hidden class="mt-4 max-w-sm rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-[13px] text-white/70 backdrop-blur-sm"></div>
    </div>
  </div>
  <Wave before="var(--color-navy)" after="var(--color-bg-soft)" />

  <div class="bg-bg-soft px-5 pt-6 pb-16 sm:px-8 sm:pt-8">
    <div class="mx-auto max-w-6xl">
      <div id="page-error" hidden class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>
      <div id="page-loading" class="rounded-2xl bg-white p-8 text-[14px] text-ink-soft shadow-[0_25px_60px_-30px_rgba(11,20,84,0.4)]">Loading…</div>

      <div id="page-content" hidden>
        <!-- tabs -->
        <div class="flex gap-6 border-b border-line text-[14px]">
          <button
            id="tab-search"
            type="button"
            class="tab-button border-b-2 border-navy px-1 pb-3 font-semibold text-navy"
          >
            Search
          </button>
          <button
            id="tab-history"
            type="button"
            class="tab-button border-b-2 border-transparent px-1 pb-3 font-medium text-ink-faint transition-colors hover:text-ink-soft"
          >
            History
          </button>
          <button
            id="tab-plans"
            type="button"
            class="tab-button border-b-2 border-transparent px-1 pb-3 font-medium text-ink-faint transition-colors hover:text-ink-soft"
          >
            Plans
          </button>
        </div>

        <!-- Search tab -->
        <div id="panel-search">
          <!-- Step 1: query -->
          <div id="step-query" class="mt-6 rounded-2xl bg-white p-6 shadow-[0_25px_60px_-30px_rgba(11,20,84,0.4)] sm:p-7">
            <label for="query-input" class="mb-1.5 block text-[13px] font-semibold text-ink">Who are you looking for?</label>
            <div class="relative">
              <span class="pointer-events-none absolute left-4 top-3.5 text-lime" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M12 3.5 13.4 8l4.6 1.4-4.6 1.4L12 15.2l-1.4-4.4L6 9.4l4.6-1.4L12 3.5Z" fill="currentColor" />
                </svg>
              </span>
              <textarea
                id="query-input"
                rows="2"
                placeholder=""
                class="w-full resize-none rounded-xl border-2 border-line py-3 pl-10 pr-4 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
              ></textarea>

              <div
                id="suggestions-dropdown"
                hidden
                class="absolute left-0 right-0 top-full z-10 mt-2 rounded-xl border border-line bg-white p-2 shadow-[0_20px_40px_-20px_rgba(11,20,84,0.35)]"
              >
                <p class="px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-ink-faint">Search suggestions</p>
                <div id="suggestions-list"></div>
              </div>
            </div>

            <button
              id="review-button"
              type="button"
              class="mt-5 w-full rounded-full bg-lime py-3.5 text-center text-[15px] font-semibold text-navy-dark shadow-[0_15px_30px_-15px_rgba(11,20,84,0.6)] transition-all hover:-translate-y-0.5 hover:bg-lime-dark disabled:pointer-events-none disabled:translate-y-0 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Review search →
            </button>
          </div>

          <!-- Step 2: review parameters -->
          <div id="step-review" hidden class="mt-6 rounded-2xl bg-white p-6 shadow-[0_25px_60px_-30px_rgba(11,20,84,0.4)] sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-display text-lg font-extrabold tracking-tight text-ink">Review search parameters</h2>
              <button id="review-back" type="button" class="shrink-0 text-[13px] font-medium text-navy hover:text-navy-mid">← Edit query</button>
            </div>
            <p class="mt-1 text-[13px] text-ink-soft">We pulled these from your query — edit anything before running the real search.</p>

            <div id="review-loading" class="mt-6 flex items-center gap-2.5 text-[13px] text-ink-soft">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-lime"></span>
              Reading your query…
            </div>

            <div id="review-fields" hidden class="mt-6 space-y-5">
              <div>
                <label for="field-campaign-name" class="mb-1.5 block text-[13px] font-semibold text-ink">Campaign name</label>
                <input
                  id="field-campaign-name"
                  type="text"
                  maxlength="200"
                  class="w-full rounded-xl border-2 border-line px-3.5 py-2.5 text-[14px] text-ink focus:border-navy focus:outline-none"
                />
              </div>

              <div class="relative">
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Search keywords</label>
                <div id="field-keywords" class="tag-input flex flex-wrap items-center gap-2 rounded-xl border-2 border-line px-3 py-2">
                  <input type="text" placeholder="Type and press Enter" class="tag-text-input min-w-[140px] flex-1 py-1 text-[13px] text-ink placeholder:text-ink-faint focus:outline-none" />
                </div>
                <div id="field-keywords-suggestions" hidden class="absolute left-0 right-0 top-full z-10 mt-1 rounded-xl border border-line bg-white p-1.5 shadow-[0_20px_40px_-20px_rgba(11,20,84,0.35)]"></div>
              </div>

              <div class="relative">
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Target industries</label>
                <div id="field-industries" class="tag-input flex flex-wrap items-center gap-2 rounded-xl border-2 border-line px-3 py-2">
                  <input type="text" placeholder="Type and press Enter" class="tag-text-input min-w-[140px] flex-1 py-1 text-[13px] text-ink placeholder:text-ink-faint focus:outline-none" />
                </div>
                <div id="field-industries-suggestions" hidden class="absolute left-0 right-0 top-full z-10 mt-1 rounded-xl border border-line bg-white p-1.5 shadow-[0_20px_40px_-20px_rgba(11,20,84,0.35)]"></div>
              </div>

              <div class="relative">
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Target roles</label>
                <div id="field-roles" class="tag-input flex flex-wrap items-center gap-2 rounded-xl border-2 border-line px-3 py-2">
                  <input type="text" placeholder="Type and press Enter" class="tag-text-input min-w-[140px] flex-1 py-1 text-[13px] text-ink placeholder:text-ink-faint focus:outline-none" />
                </div>
                <div id="field-roles-suggestions" hidden class="absolute left-0 right-0 top-full z-10 mt-1 rounded-xl border border-line bg-white p-1.5 shadow-[0_20px_40px_-20px_rgba(11,20,84,0.35)]"></div>
              </div>

              <div>
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Seniority</label>
                <div id="field-seniority" class="flex flex-wrap gap-2"></div>
              </div>

              <div>
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Department / job function</label>
                <div class="relative">
                  <button
                    id="dept-dropdown-toggle"
                    type="button"
                    class="flex w-full items-center justify-between rounded-xl border-2 border-line px-3.5 py-2.5 text-left text-[13px] text-ink-soft transition-colors hover:border-navy"
                  >
                    <span id="dept-summary">Any department</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <div
                    id="dept-dropdown"
                    hidden
                    class="absolute left-0 right-0 top-full z-10 mt-2 max-h-72 overflow-y-auto rounded-xl border border-line bg-white p-2 shadow-[0_20px_40px_-20px_rgba(11,20,84,0.35)]"
                  >
                    <input
                      id="dept-search"
                      type="text"
                      placeholder="Search departments…"
                      class="mb-2 w-full rounded-lg border border-line px-3 py-1.5 text-[13px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
                    />
                    <div id="dept-list"></div>
                  </div>
                </div>
                <p class="mt-1.5 text-[11px] text-ink-faint">Items marked "browse only" don't narrow results yet — pick from the others to filter by function.</p>
              </div>

              <div>
                <label for="field-location" class="mb-1.5 block text-[13px] font-semibold text-ink">Location</label>
                <input
                  id="field-location"
                  type="text"
                  placeholder="e.g. Boston, MA"
                  class="w-full rounded-xl border-2 border-line px-3.5 py-2.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
                />
              </div>

              <div>
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Company size</label>
                <div id="field-company-size" class="flex flex-wrap gap-2"></div>
              </div>

              <div>
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Revenue range</label>
                <div class="flex items-center gap-3">
                  <input id="field-revenue-min" type="number" min="0" placeholder="Min $" class="w-full rounded-xl border-2 border-line px-3.5 py-2.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none" />
                  <span class="text-ink-faint">–</span>
                  <input id="field-revenue-max" type="number" min="0" placeholder="Max $" class="w-full rounded-xl border-2 border-line px-3.5 py-2.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none" />
                </div>
              </div>

              <div>
                <label class="mb-1.5 block text-[13px] font-semibold text-ink">Exclusions</label>
                <div id="field-exclusions" class="tag-input flex flex-wrap items-center gap-2 rounded-xl border-2 border-line px-3 py-2">
                  <input type="text" placeholder="Company keywords to exclude, press Enter" class="tag-text-input min-w-[140px] flex-1 py-1 text-[13px] text-ink placeholder:text-ink-faint focus:outline-none" />
                </div>
              </div>

              <button
                id="run-search-button"
                type="button"
                class="w-full rounded-full bg-lime py-3.5 text-center text-[15px] font-semibold text-navy-dark shadow-[0_15px_30px_-15px_rgba(11,20,84,0.6)] transition-all hover:-translate-y-0.5 hover:bg-lime-dark disabled:pointer-events-none disabled:translate-y-0 disabled:cursor-not-allowed disabled:opacity-60"
              >
                Search →
              </button>
            </div>
          </div>

          <!-- results -->
          <div id="results-section" hidden class="mt-6"></div>
        </div>

        <!-- History tab -->
        <div id="panel-history" hidden>
          <div id="history-list" class="mt-6 divide-y divide-line rounded-2xl border border-line bg-white"></div>

          <div id="history-detail" hidden class="mt-6">
            <button id="history-back" type="button" class="mb-3 text-[13px] font-medium text-navy hover:text-navy-mid">← Back to history</button>
            <p id="history-detail-query" class="mb-3 font-display text-lg font-extrabold tracking-tight text-ink"></p>
            <div id="history-detail-view"></div>
          </div>
        </div>

        <!-- Plans tab -->
        <div id="panel-plans" hidden>
          <div class="mt-6 rounded-2xl bg-white p-6 shadow-[0_25px_60px_-30px_rgba(11,20,84,0.4)] sm:p-7">
            <h2 class="font-display text-lg font-extrabold tracking-tight text-ink">Lead Finder plans</h2>
            <p class="mt-1 text-[13px] text-ink-soft">Pick a monthly allowance, then top up with one-time credit packs whenever you need more.</p>
            <p id="plan-status-line" class="mt-3 text-[13px] font-medium text-navy"></p>

            <div id="plan-error" hidden class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>

            <div id="plan-cards" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

            <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-5 text-[13px] text-ink-soft">
              <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke="#4d7c0f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Verified, deduplicated leads</span>
              <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke="#4d7c0f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Credits top up every cycle</span>
              <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke="#4d7c0f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Credits never expire</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="credits-modal"
    hidden
    class="fixed inset-0 z-50 flex items-center justify-center bg-navy/40 px-5 backdrop-blur-sm"
  >
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-[0_30px_80px_-20px_rgba(11,20,84,0.5)]">
      <div class="grid h-11 w-11 place-items-center rounded-full bg-red-50">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L14.71 3.86a2 2 0 0 0-3.42 0Z" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <h2 id="credits-modal-heading" class="mt-3 font-display text-lg font-extrabold tracking-tight text-ink">Out of credits</h2>
      <p id="credits-modal-message" class="mt-1.5 text-[13px] text-ink-soft">You're out of Lead Finder credits. Buy more or upgrade your plan to keep searching.</p>
      <div class="mt-5 flex flex-col gap-2">
        <button id="credits-modal-plans" type="button" class="w-full rounded-full bg-navy py-2.5 text-[13px] font-semibold text-white transition-colors hover:bg-navy-mid">View plans →</button>
        <button id="credits-modal-close" type="button" class="w-full rounded-full border-2 border-line py-2.5 text-[13px] font-semibold text-ink transition-colors hover:border-ink-faint">Not now</button>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { authFetch, ApiError } from "../lib/api";
  import { clearAccessToken, ensureAuthenticated, redirectToSignin } from "../lib/session";

  interface SearchResult {
    id: string;
    apolloPersonId: string;
    name: string | null;
    title: string | null;
    company: string | null;
    linkedin: string | null;
    email: string | null;
    status: string;
    reviewStatus: "new" | "approved" | "skipped";
    createdAt: string;
  }
  interface SearchJob {
    id: string;
    query: string;
    jobTitles: string[] | null;
    status: "RUNNING" | "COMPLETED" | "FAILED" | "CANCELLED";
    createdAt: string;
    results: SearchResult[];
  }
  interface HistoryItem {
    id: string;
    query: string;
    jobTitles: string[] | null;
    status: string;
    resultCount: number;
    createdAt: string;
  }
  interface CreditsResponse {
    credits: number;
    isPaidTier: boolean;
    maxResultsPerSearch: number;
    searchesUsedToday: number;
    maxSearchesPerDay: number;
    searchesRemainingToday: number | null;
  }
  interface CreditPack {
    id: string;
    slug: string;
    name: string;
    credits: number;
    amountCents: number;
    currency: string;
  }
  interface LeadFinderTier {
    id: string;
    slug: string;
    name: string;
    credits: number;
    amountCents: number;
    currency: string;
    recurring: boolean;
  }
  interface LeadFinderStatus {
    tierSlug: string;
    status: "NONE" | "TRIALING" | "ACTIVE" | "PAST_DUE" | "CANCELED" | "EXPIRED";
    currentPeriodEnd?: string;
    cancelAtPeriodEnd?: boolean;
  }
  interface ParsedFilters {
    campaignName: string;
    searchKeywords: string[];
    targetIndustries: string[];
    personTitles: string[];
    personSeniorities: string[];
    location: string;
    personName: string;
    personOrganization: string;
  }
  interface DepartmentItem {
    label: string;
    mapsTo?: string | null;
  }
  interface DepartmentSection {
    section: string;
    mapsTo: string | null;
    items: DepartmentItem[];
  }
  interface Taxonomy {
    personSeniorities: string[];
    companySizeRanges: { label: string; value: string }[];
    revenueBuckets: { label: string; value: number }[];
    departments: DepartmentSection[];
  }

  const SENIORITY_LABELS: Record<string, string> = {
    owner: "Owner",
    founder: "Founder",
    c_suite: "C-Suite",
    partner: "Partner",
    vp: "VP",
    head: "Head",
    director: "Director",
    manager: "Manager",
    senior: "Senior",
    entry: "Entry",
    intern: "Intern",
  };

  const EXAMPLE_QUERIES = [
    "CMOs at affiliate marketing networks attending Affiliate Summit",
    "Founders of lead-gen agencies in the US",
    "VP of Marketing at companies similar to Thumbtack",
  ];

  // Common real job titles for instant "Target roles" suggestions — no
  // network round-trip needed, and not limited to whatever happens to be
  // in our own ~21.7k-row Directory (this covers roles from any industry,
  // since Apollo search itself isn't limited to our directory either).
  const COMMON_JOB_TITLES = [
    "CEO", "CFO", "COO", "CTO", "CMO", "CIO", "CHRO",
    "Founder", "Co-Founder", "Owner", "Partner", "President", "Vice President",
    "Managing Director", "General Manager",
    "Director", "Senior Director", "Sales Director", "Marketing Director",
    "Engineering Director", "Product Director", "Operations Director",
    "HR Director", "Creative Director", "Finance Director",
    "Manager", "Senior Manager", "Project Manager", "Product Manager",
    "Program Manager", "Sales Manager", "Marketing Manager", "Operations Manager",
    "Account Manager", "HR Manager", "IT Manager", "Customer Success Manager",
    "Brand Manager",
    "Account Executive", "Sales Representative", "Business Development Manager",
    "BDR", "SDR", "Enterprise Account Executive", "Inside Sales",
    "Head of Sales", "VP of Sales",
    "Marketing Coordinator", "Digital Marketing Manager", "Content Manager",
    "SEO Manager", "Growth Manager", "Demand Generation Manager",
    "Social Media Manager", "Head of Marketing", "VP of Marketing",
    "Software Engineer", "Senior Software Engineer", "Full Stack Developer",
    "Frontend Developer", "Backend Developer", "DevOps Engineer", "Data Engineer",
    "Engineering Manager", "Solutions Architect", "Technical Lead",
    "VP of Engineering", "Product Owner",
    "UX Designer", "UI Designer", "Product Designer",
    "Head of Product", "VP of Product",
    "Data Scientist", "Data Analyst", "Business Analyst", "Analytics Manager",
    "BI Analyst", "Financial Analyst", "Accountant", "Controller",
    "Finance Manager", "Treasurer",
    "Recruiter", "Talent Acquisition", "HR Business Partner",
    "People Operations Manager", "Head of HR",
    "Consultant", "Executive Assistant", "Office Manager",
    "Customer Support Manager", "Legal Counsel",
    "Real Estate Agent", "Broker", "Advisor",
  ];

  // Standard LinkedIn-style industry taxonomy for instant "Target
  // industries" suggestions — same reasoning as COMMON_JOB_TITLES: real,
  // standard category names, not limited to the 6 narrow company types in
  // our own Directory dataset.
  const COMMON_INDUSTRIES = [
    "Information Technology & Services", "Construction", "Marketing & Advertising",
    "Real Estate", "Health, Wellness & Fitness", "Management Consulting",
    "Computer Software", "Internet", "Retail", "Financial Services",
    "Consumer Services", "Hospital & Health Care", "Automotive", "Restaurants",
    "Education Management", "Food & Beverages", "Design", "Hospitality",
    "Accounting", "Events Services", "Nonprofit Organization Management",
    "Entertainment", "Electrical/Electronic Manufacturing",
    "Leisure, Travel & Tourism", "Professional Training & Coaching",
    "Transportation/Trucking/Railroad", "Law Practice", "Apparel & Fashion",
    "Architecture & Planning", "Mechanical or Industrial Engineering",
    "Insurance", "Telecommunications", "Human Resources", "Staffing & Recruiting",
