    const filterTabs = root.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const getMoreBtn = root.querySelector<HTMLButtonElement>("[data-get-more]")!;
    const getMoreBottomRow = root.querySelector<HTMLDivElement>("[data-get-more-bottom-row]")!;
    const getMoreBottomBtn = root.querySelector<HTMLButtonElement>("[data-get-more-bottom]")!;
    const exportBtn = root.querySelector<HTMLButtonElement>("[data-export]")!;
    const viewToggles = root.querySelectorAll<HTMLButtonElement>("[data-view]");
    const bulkBar = root.querySelector<HTMLDivElement>("[data-bulk-bar]")!;
    const bulkCount = root.querySelector<HTMLSpanElement>("[data-bulk-count]")!;
    const summary = root.querySelector<HTMLParagraphElement>("[data-summary]")!;
    const tableWrap = root.querySelector<HTMLDivElement>("[data-table-wrap]")!;
    const tableBody = root.querySelector<HTMLTableSectionElement>("[data-table-body]")!;
    const gridWrap = root.querySelector<HTMLDivElement>("[data-grid-wrap]")!;
    const selectAll = root.querySelector<HTMLInputElement>("[data-select-all]")!;

    let jobId = "";
    let allResults: SearchResult[] = [];
    let filter: "all" | "approved" | "skipped" = "all";
    let viewMode: "table" | "grid" = "table";
    let selected = new Set<string>();
    let exportFilename = "lead-finder-results.csv";
    let onGetMoreStarted: (() => void) | undefined;

    function filteredResults(): SearchResult[] {
      if (filter === "approved") return allResults.filter((r) => r.reviewStatus === "approved");
      if (filter === "skipped") return allResults.filter((r) => r.reviewStatus === "skipped");
      return allResults;
    }

    function refreshChrome(): void {
      const total = allResults.length;
      const approvedCount = allResults.filter((r) => r.reviewStatus === "approved").length;
      const skippedCount = allResults.filter((r) => r.reviewStatus === "skipped").length;
      filterTabs.forEach((btn) => {
        const key = btn.dataset.filter as typeof filter;
        btn.textContent =
          key === "all"
            ? `All Contacts (${total})`
            : key === "approved"
              ? `Approved (${approvedCount})`
              : `Skipped (${skippedCount})`;
        const active = key === filter;
        btn.classList.toggle("bg-white", active);
        btn.classList.toggle("text-navy", active);
        btn.classList.toggle("shadow-sm", active);
        btn.classList.toggle("text-ink-soft", !active);
      });
      const enrichedCount = allResults.filter((r) => r.status === "enriched").length;
      const pendingCount = allResults.filter((r) => r.status === "pending").length;
      const failedCount = allResults.filter((r) => r.status === "failed").length;
      if (total === 0) {
        summary.textContent = "";
      } else if (pendingCount > 0) {
        summary.textContent = `Finding leads… ${enrichedCount} enriched so far`;
      } else {
        summary.textContent = `${enrichedCount} lead${enrichedCount === 1 ? "" : "s"} enriched${failedCount ? `, ${failedCount} not found` : ""}`;
      }
      exportBtn.hidden = total === 0;
      tableWrap.hidden = viewMode !== "table";
      gridWrap.hidden = viewMode !== "grid";
      viewToggles.forEach((btn) => {
        const active = btn.dataset.view === viewMode;
        btn.classList.toggle("bg-bg-soft", active);
        btn.classList.toggle("text-navy", active);
        btn.classList.toggle("text-ink-faint", !active);
      });
    }

    function refreshBulkBar(): void {
      bulkBar.hidden = selected.size === 0;
      bulkCount.textContent = `${selected.size} selected`;
    }

    function refreshRows(): void {
      const rows = filteredResults();
      if (rows.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-[13px] text-ink-faint">No leads in this view.</td></tr>`;
        gridWrap.innerHTML = `<p class="col-span-full px-4 py-8 text-center text-[13px] text-ink-faint">No leads in this view.</p>`;
      } else {
        tableBody.innerHTML = rows.map(tableRowHtml).join("");
        gridWrap.innerHTML = rows.map(resultCardHtml).join("");
      }
      root.querySelectorAll<HTMLInputElement>(".row-select").forEach((cb) => {
        cb.checked = selected.has(cb.dataset.selectId!);
      });
      refreshBulkBar();
    }

    filterTabs.forEach((btn) =>
      btn.addEventListener("click", () => {
        filter = btn.dataset.filter as typeof filter;
        selected = new Set();
        refreshChrome();
        refreshRows();
      }),
    );

    viewToggles.forEach((btn) =>
      btn.addEventListener("click", () => {
        viewMode = btn.dataset.view as typeof viewMode;
        refreshChrome();
      }),
    );

    exportBtn.addEventListener("click", () => exportResultsCsv(filteredResults(), exportFilename));

    selectAll.addEventListener("change", () => {
      const selectableRows = filteredResults().filter((r) => r.status === "enriched");
      if (selectAll.checked) selectableRows.forEach((r) => selected.add(r.id));
      else selected.clear();
      refreshRows();
    });

    root.addEventListener("change", (event) => {
      const target = event.target as HTMLElement;
      if (target.classList.contains("row-select")) {
        const id = (target as HTMLInputElement).dataset.selectId!;
        if ((target as HTMLInputElement).checked) selected.add(id);
        else selected.delete(id);
        refreshBulkBar();
      }
    });

    async function applyReview(resultId: string, reviewStatus: "approved" | "skipped"): Promise<void> {
      try {
        await authFetch(`/leads/ai-search/${jobId}/results/${resultId}`, {
          method: "PATCH",
          body: JSON.stringify({ reviewStatus }),
        });
        const target = allResults.find((r) => r.id === resultId);
        if (target) target.reviewStatus = reviewStatus;
        refreshChrome();
        refreshRows();
      } catch (err) {
        handleError(err);
      }
    }

    root.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-review-action]");
      if (button) {
        void applyReview(button.dataset.resultId!, button.dataset.reviewAction as "approved" | "skipped");
      }
    });

    let bulkBusy = false;
    async function bulkApply(status: "approved" | "skipped"): Promise<void> {
      if (bulkBusy) return;
      bulkBusy = true;
      for (const id of selected) {
        await applyReview(id, status);
      }
      selected = new Set();
      refreshRows();
      bulkBusy = false;
    }
    root.querySelector<HTMLButtonElement>("[data-bulk-approve]")!.addEventListener("click", () => void bulkApply("approved"));
    root.querySelector<HTMLButtonElement>("[data-bulk-skip]")!.addEventListener("click", () => void bulkApply("skipped"));

    const getMoreButtons = [getMoreBtn, getMoreBottomBtn];

    function setGetMoreState(visible: boolean, busy = false): void {
      getMoreBtn.hidden = !visible;
      getMoreBottomRow.hidden = !visible;
      for (const btn of getMoreButtons) {
        btn.disabled = busy;
        btn.textContent = busy ? "Finding more…" : "↻ Get 25 more leads";
      }
    }

    async function handleGetMore(): Promise<void> {
      setGetMoreState(true, true);
      try {
        await authFetch(`/leads/ai-search/${jobId}/more`, { method: "POST", body: JSON.stringify({}) });
        setGetMoreState(false);
        onGetMoreStarted?.();
      } catch (err) {
        setGetMoreState(true, false);
        handleError(err);
      }
    }

    for (const btn of getMoreButtons) {
      btn.addEventListener("click", () => void handleGetMore());
    }

    return {
      render(newJobId, results, canGetMore, filename, onGetMore) {
        jobId = newJobId;
        allResults = results;
        filter = "all";
        selected = new Set();
        exportFilename = filename;
        setGetMoreState(canGetMore, false);
        onGetMoreStarted = onGetMore;
        refreshChrome();
        refreshRows();
      },
      updateResults(results) {
        allResults = results;
        refreshChrome();
        refreshRows();
      },
      setGetMoreVisible(visible) {
        setGetMoreState(visible, false);
      },
    };
  }

  const searchResultsView = createResultsView(resultsSection);
  const historyResultsView = createResultsView(historyDetailView);

  function csvField(value: string): string {
    return /[",\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
  }

  function slugifyFilename(value: string): string {
    const slug = value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
    return slug || "lead-finder-results";
  }

  function exportResultsCsv(results: SearchResult[], filename = "lead-finder-results.csv"): void {
    const header = ["Company", "Name", "Title", "LinkedIn", "Email", "Status"];
    const rows = results.map((r) => [
      r.company ?? "",
      r.name ?? "",
      r.title ?? "",
      r.linkedin ?? "",
      r.email ?? "",
      r.status,
    ]);
    const csv = [header, ...rows].map((row) => row.map(csvField).join(",")).join("\r\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  function updateCredits(credits: CreditsResponse): void {
    creditsLabel.textContent = `${credits.credits.toLocaleString()} credit${credits.credits === 1 ? "" : "s"} remaining`;

    if (credits.isPaidTier || credits.searchesRemainingToday === null) {
      freeTierNotice.hidden = true;
      return;
    }
    const remaining = credits.searchesRemainingToday;
    freeTierNotice.textContent =
      remaining <= 0
        ? `All ${credits.maxSearchesPerDay} free searches used today — upgrade for unlimited searches.`
        : `${remaining} free search${remaining === 1 ? "" : "es"} remaining today (${credits.maxResultsPerSearch} results each).`;
    freeTierNotice.hidden = false;
  }

