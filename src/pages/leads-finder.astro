  async function loadTaxonomy(): Promise<void> {
    try {
      const taxonomy = await authFetch<Taxonomy>("/leads/taxonomy");
      senioritySelect = createPillSelect(
        fieldSeniority,
        taxonomy.personSeniorities.map((s) => ({ value: s, label: SENIORITY_LABELS[s] ?? s })),
      );
      companySizeSelect = createPillSelect(
