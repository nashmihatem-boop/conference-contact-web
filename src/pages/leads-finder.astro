  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function statusBadge(status: string): string {
    switch (status) {
      case "enriched":
        return `<span class="rounded-full bg-lime-tint px-2.5 py-1 text-[12px] font-medium text-navy">Enriched</span>`;
      case "pending":
        return `<span class="inline-flex items-center gap-1.5 rounded-full bg-bg-soft px-2.5 py-1 text-[12px] font-medium text-ink-soft"><span class="h-1.5 w-1.5 animate-pulse rounded-full bg-ink-faint"></span>Enriching…</span>`;
      case "failed":
        return `<span class="rounded-full bg-red-50 px-2.5 py-1 text-[12px] font-medium text-red-600">Not found</span>`;
      case "skipped":
        return `<span class="rounded-full bg-bg-soft px-2.5 py-1 text-[12px] font-medium text-ink-faint">Skipped</span>`;
      default:
        return `<span class="text-ink-faint">—</span>`;
    }
  }

  function initials(name: string): string {
    const parts = name.trim().split(/\s+/);
    return ((parts[0]?.[0] ?? "") + (parts[parts.length - 1]?.[0] ?? "")).toUpperCase();
  }

  function reviewBadge(reviewStatus: SearchResult["reviewStatus"]): string {
    switch (reviewStatus) {
      case "approved":
        return `<span class="rounded-full bg-lime-tint px-2.5 py-1 text-[12px] font-medium text-navy">Approved</span>`;
      case "skipped":
        return `<span class="rounded-full bg-bg-soft px-2.5 py-1 text-[12px] font-medium text-ink-faint">Skipped</span>`;
      default:
        return `<span class="rounded-full bg-amber-50 px-2.5 py-1 text-[12px] font-medium text-amber-700">New</span>`;
    }
  }

  function statusCellHtml(result: SearchResult): string {
    return result.status === "enriched" ? reviewBadge(result.reviewStatus) : statusBadge(result.status);
  }

  function actionCellHtml(result: SearchResult): string {
    if (result.status !== "enriched") {
      return `<span class="text-[12px] text-ink-faint">—</span>`;
    }
    const isApproved = result.reviewStatus === "approved";
    const isSkipped = result.reviewStatus === "skipped";
    const skipBtn = isSkipped
      ? `<button type="button" disabled class="rounded-full border border-line px-3 py-1 text-[12px] font-medium text-ink-faint">Skipped</button>`
      : `<button type="button" data-review-action="skipped" data-result-id="${result.id}" class="rounded-full border border-line px-3 py-1 text-[12px] font-medium text-ink transition-colors hover:border-ink-faint">Skip</button>`;
    const approveBtn = isApproved
      ? `<button type="button" disabled class="rounded-full bg-lime-tint px-3 py-1 text-[12px] font-semibold text-navy/50">Approved</button>`
      : `<button type="button" data-review-action="approved" data-result-id="${result.id}" class="rounded-full bg-navy px-3 py-1 text-[12px] font-semibold text-white transition-colors hover:bg-navy-mid">Approve</button>`;
    return `<div class="flex items-center gap-1.5">${skipBtn}${approveBtn}</div>`;
  }

  function tableRowHtml(result: SearchResult): string {
    const nameCell = result.name
      ? `<div class="flex items-center gap-2.5">
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-lime-tint text-[11px] font-semibold text-navy">${escapeHtml(initials(result.name))}</span>
          <span>${escapeHtml(result.name)}</span>
        </div>`
      : "—";
    const selectable = result.status === "enriched";
    return `
      <tr class="border-b border-line last:border-b-0" data-result-row="${result.id}">
        <td class="px-4 py-3">${selectable ? `<input type="checkbox" data-select-id="${result.id}" class="row-select h-3.5 w-3.5 rounded border-line" />` : ""}</td>
        <td class="px-4 py-3 text-[13px] text-ink">${result.company ? escapeHtml(result.company) : "—"}</td>
        <td class="px-4 py-3 text-[13px] font-medium text-ink">${nameCell}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft">${result.title ? escapeHtml(result.title) : "—"}</td>
        <td class="px-4 py-3 text-[13px]">${result.linkedin ? `<a href="${escapeHtml(result.linkedin)}" target="_blank" rel="noopener noreferrer" class="text-navy hover:text-navy-mid">View profile</a>` : "—"}</td>
        <td class="px-4 py-3 text-[13px] text-ink-soft">${result.email ? escapeHtml(result.email) : "—"}</td>
        <td class="px-4 py-3">${statusCellHtml(result)}</td>
        <td class="px-4 py-3">${actionCellHtml(result)}</td>
      </tr>`;
  }

  function resultCardHtml(result: SearchResult): string {
    const selectable = result.status === "enriched";
    return `
      <div class="rounded-xl border border-line bg-white p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="truncate text-[13px] font-semibold text-ink">${result.name ? escapeHtml(result.name) : "—"}</p>
            <p class="truncate text-[12px] text-ink-faint">${result.title ? escapeHtml(result.title) : "—"}</p>
          </div>
          ${statusCellHtml(result)}
        </div>
        <div class="mt-3 rounded-lg bg-bg-soft px-3 py-2 text-[12px] text-ink-soft">
          <p class="truncate font-medium text-ink">${result.company ? escapeHtml(result.company) : "—"}</p>
          ${result.linkedin ? `<a href="${escapeHtml(result.linkedin)}" target="_blank" rel="noopener noreferrer" class="mt-1 block truncate text-navy hover:text-navy-mid">LinkedIn ↗</a>` : ""}
          ${result.email ? `<p class="mt-1 truncate">${escapeHtml(result.email)}</p>` : ""}
        </div>
        <div class="mt-3 flex items-center justify-between gap-2">
          ${selectable ? `<input type="checkbox" data-select-id="${result.id}" class="row-select h-3.5 w-3.5 rounded border-line" />` : "<span></span>"}
          ${actionCellHtml(result)}
        </div>
      </div>`;
  }

