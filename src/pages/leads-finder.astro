  // Every Lead Finder-specific reason the backend blocks an action (out of
  // credits, daily free-search cap, free plan can't "get more leads") gets
  // the same upgrade-prompt modal instead of the generic redirect-to-account
  // handling other 403s get — matched by a distinctive phrase from each
  // real server message rather than the generic "Lead Finder" substring,
  // since these come from different endpoints with different wording.
  const UPGRADE_BLOCK_PHRASES = [
    "out of Lead Finder credits",
    "free searches today",
    "get more leads per search",
  ];

  function handleError(err: unknown): void {
    if (err instanceof ApiError && err.statusCode === 401) {
      clearAccessToken();
      redirectToSignin();
      return;
    }
    if (
      err instanceof ApiError &&
      err.statusCode === 403 &&
      UPGRADE_BLOCK_PHRASES.some((phrase) => err.message.includes(phrase))
    ) {
      showCreditsModal("Keep the leads coming", err.message);
      return;
    }
    if (err instanceof ApiError && err.statusCode === 403 && !err.message.includes("Lead Finder")) {
      window.location.href = "/account";
      return;
    }
    pageError.textContent =
      err instanceof ApiError ? err.message : "Something went wrong. Please try again.";
    pageError.hidden = false;
  }

