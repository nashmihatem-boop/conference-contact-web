  // ── Reusable tag-input / pill-select widgets ────────────────────────

  interface TagInput {
    getValues(): string[];
    setValues(values: string[]): void;
  }

  type SuggestField = "title" | "company";

  function createTagInput(
    container: HTMLDivElement,
    suggestionsEl?: HTMLDivElement,
    suggestField?: SuggestField,
    staticOptions?: string[],
  ): TagInput {
    const textInput = container.querySelector<HTMLInputElement>(".tag-text-input")!;
    let values: string[] = [];

    function render(): void {
      container.querySelectorAll("[data-tag]").forEach((el) => el.remove());
      for (const value of values) {
        const chip = document.createElement("span");
        chip.dataset.tag = "true";
        chip.className =
          "inline-flex items-center gap-1 rounded-full bg-lime-tint px-2.5 py-1 text-[12px] font-medium text-navy";
        chip.textContent = value;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.className = "ml-0.5 text-navy hover:text-navy-mid";
        remove.addEventListener("click", () => {
          values = values.filter((v) => v !== value);
          render();
        });
        chip.appendChild(remove);
        container.insertBefore(chip, textInput);
      }
    }

    function addValue(value: string): void {
      const trimmed = value.trim();
      if (trimmed && !values.includes(trimmed)) {
        values = [...values, trimmed];
        render();
      }
      textInput.value = "";
      if (suggestionsEl) suggestionsEl.hidden = true;
    }

    textInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === ",") {
        event.preventDefault();
        addValue(textInput.value);
      }
    });

    function renderSuggestionOptions(options: string[]): void {
      if (!suggestionsEl) return;
      const filtered = options.filter((label) => !values.includes(label));
      if (filtered.length === 0) {
        suggestionsEl.hidden = true;
        return;
      }
      suggestionsEl.innerHTML = filtered
        .slice(0, 8)
        .map(
          (label) => `
          <button type="button" data-suggest-value="${escapeHtml(label)}" class="suggest-item block w-full rounded-lg px-2.5 py-1.5 text-left text-[13px] text-ink transition-colors hover:bg-bg-soft">${escapeHtml(label)}</button>`,
        )
        .join("");
      suggestionsEl.querySelectorAll<HTMLButtonElement>(".suggest-item").forEach((btn) => {
        btn.addEventListener("mousedown", (event) => {
          event.preventDefault();
          addValue(btn.dataset.suggestValue!);
        });
      });
      suggestionsEl.hidden = false;
    }

    if (suggestionsEl && staticOptions) {
      // Instant, offline filtering — no debounce or network round-trip
      // needed for a fixed, already-loaded list.
      textInput.addEventListener("input", () => {
        const q = textInput.value.trim().toLowerCase();
        if (!q) {
          suggestionsEl.hidden = true;
          return;
        }
        renderSuggestionOptions(staticOptions.filter((t) => t.toLowerCase().includes(q)));
      });
      textInput.addEventListener("focus", () => {
        if (!textInput.value.trim()) renderSuggestionOptions(staticOptions);
      });
      textInput.addEventListener("blur", () => {
        setTimeout(() => {
          suggestionsEl.hidden = true;
        }, 150);
      });
    }

    if (suggestionsEl && suggestField) {
      let debounceTimer: ReturnType<typeof setTimeout> | undefined;
      let requestToken = 0;

      async function fetchSuggestions(q: string): Promise<void> {
        const token = ++requestToken;
        try {
          const rows = await authFetch<{ value: string }[]>(
            `/leads/suggest?field=${suggestField}&q=${encodeURIComponent(q)}`,
          );
          if (token !== requestToken) return;
          renderSuggestionOptions(rows.map((r) => r.value));
        } catch {
          suggestionsEl!.hidden = true;
        }
      }

      textInput.addEventListener("input", () => {
        const q = textInput.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);
        if (q.length < 2) {
          suggestionsEl.hidden = true;
          return;
        }
        debounceTimer = setTimeout(() => void fetchSuggestions(q), 220);
      });
      textInput.addEventListener("blur", () => {
        setTimeout(() => {
          suggestionsEl.hidden = true;
        }, 150);
      });
    }

    return {
      getValues: () => values,
      setValues: (next) => {
        values = [...next];
        render();
      },
    };
  }

  interface PillSelect {
    getValues(): string[];
    setValues(values: string[]): void;
  }

  function createPillSelect(
    container: HTMLDivElement,
    options: { value: string; label: string }[],
  ): PillSelect {
    let selected = new Set<string>();
    container.innerHTML = options
      .map(
        (opt) => `
      <button type="button" data-pill-value="${escapeHtml(opt.value)}" class="pill-option rounded-full border-2 border-line px-3 py-1.5 text-[12px] font-medium text-ink-soft transition-colors hover:border-navy">
        ${escapeHtml(opt.label)}
      </button>`,
      )
      .join("");

    function refresh(): void {
      container.querySelectorAll<HTMLButtonElement>(".pill-option").forEach((btn) => {
        const value = btn.dataset.pillValue!;
        const active = selected.has(value);
        btn.classList.toggle("border-navy", active);
        btn.classList.toggle("bg-navy", active);
        btn.classList.toggle("text-white", active);
        btn.classList.toggle("border-line", !active);
        btn.classList.toggle("text-ink-soft", !active);
      });
    }

    container.querySelectorAll<HTMLButtonElement>(".pill-option").forEach((btn) => {
      btn.addEventListener("click", () => {
        const value = btn.dataset.pillValue!;
        if (selected.has(value)) selected.delete(value);
        else selected.add(value);
        refresh();
      });
    });
    refresh();

    return {
      getValues: () => [...selected],
      setValues: (values) => {
        selected = new Set(values);
        refresh();
      },
    };
  }

  const keywordsInput = createTagInput(fieldKeywords, fieldKeywordsSuggestions, "company");
  const industriesInput = createTagInput(fieldIndustries, fieldIndustriesSuggestions, undefined, COMMON_INDUSTRIES);
  const rolesInput = createTagInput(fieldRoles, fieldRolesSuggestions, undefined, COMMON_JOB_TITLES);
  const exclusionsInput = createTagInput(fieldExclusions);
  let senioritySelect: PillSelect | null = null;
  let companySizeSelect: PillSelect | null = null;

  // ── Department / job function dropdown ──────────────────────────────

  interface DeptOption {
    key: string;
    label: string;
    mapsTo: string | null;
  }
  let deptOptions: DeptOption[] = [];
  let deptSelected = new Set<string>();

  function flattenDepartments(departments: DepartmentSection[]): DeptOption[] {
    const options: DeptOption[] = [];
    for (const section of departments) {
      for (const item of section.items) {
        const mapsTo = item.mapsTo !== undefined ? (item.mapsTo ?? null) : section.mapsTo;
        const label = item.label === section.section ? section.section : `${section.section} → ${item.label}`;
        options.push({ key: `${section.section}::${item.label}`, label, mapsTo });
      }
    }
    return options;
  }

  function renderDeptList(filter: string): void {
    const q = filter.trim().toLowerCase();
    const filtered = q ? deptOptions.filter((o) => o.label.toLowerCase().includes(q)) : deptOptions;
    if (filtered.length === 0) {
      deptList.innerHTML = `<p class="px-2 py-4 text-center text-[12px] text-ink-faint">No matches</p>`;
      return;
    }
    deptList.innerHTML = filtered
      .slice(0, 400)
      .map(
        (opt) => `
      <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 text-[13px] text-ink hover:bg-bg-soft">
        <input type="checkbox" data-dept-key="${escapeHtml(opt.key)}" ${deptSelected.has(opt.key) ? "checked" : ""} class="dept-checkbox h-3.5 w-3.5 rounded border-line text-navy" />
        <span class="flex-1">${escapeHtml(opt.label)}</span>
        ${opt.mapsTo ? "" : `<span class="shrink-0 text-[11px] text-ink-faint">browse only</span>`}
      </label>`,
      )
      .join("");
    deptList.querySelectorAll<HTMLInputElement>(".dept-checkbox").forEach((cb) => {
      cb.addEventListener("change", () => {
        const key = cb.dataset.deptKey!;
        if (cb.checked) deptSelected.add(key);
        else deptSelected.delete(key);
        updateDeptSummary();
      });
    });
  }

  function updateDeptSummary(): void {
    deptSummary.textContent = deptSelected.size === 0 ? "Any department" : `${deptSelected.size} selected`;
  }

  function getDeptPersonFunctions(): string[] {
    const values = new Set<string>();
    for (const key of deptSelected) {
      const opt = deptOptions.find((o) => o.key === key);
      if (opt?.mapsTo) values.add(opt.mapsTo);
    }
    return [...values];
  }

  deptDropdownToggle.addEventListener("click", () => {
    deptDropdown.hidden = !deptDropdown.hidden;
    if (!deptDropdown.hidden) deptSearchInput.focus();
  });
  deptSearchInput.addEventListener("input", () => renderDeptList(deptSearchInput.value));
  document.addEventListener("click", (event) => {
    if (
      !deptDropdown.hidden &&
      !deptDropdown.contains(event.target as Node) &&
      !deptDropdownToggle.contains(event.target as Node)
    ) {
      deptDropdown.hidden = true;
