  // ── Query step: animated placeholder + suggestions ──────────────────

  function sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  let placeholderActive = true;

  async function runPlaceholderCycle(): Promise<void> {
    let exampleIndex = 0;
    while (placeholderActive) {
      const text = EXAMPLE_QUERIES[exampleIndex % EXAMPLE_QUERIES.length];
      exampleIndex += 1;
      for (let i = 0; i <= text.length; i++) {
        if (!placeholderActive || queryInput.value) return;
        queryInput.placeholder = text.slice(0, i);
        await sleep(38);
      }
      await sleep(1400);
      for (let i = text.length; i >= 0; i--) {
        if (!placeholderActive || queryInput.value) return;
        queryInput.placeholder = text.slice(0, i);
        await sleep(18);
      }
      await sleep(300);
    }
  }

  function renderSuggestions(): void {
    suggestionsList.innerHTML = EXAMPLE_QUERIES.map(
      (q, i) => `
      <button type="button" data-suggestion-index="${i}" class="suggestion-item flex w-full items-start gap-2 rounded-lg px-2.5 py-2 text-left text-[13px] text-ink-soft transition-colors hover:bg-bg-soft hover:text-ink">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="mt-0.5 shrink-0 text-ink-faint" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="m20 20-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>${escapeHtml(q)}</span>
      </button>`,
    ).join("");
    suggestionsList.querySelectorAll<HTMLButtonElement>(".suggestion-item").forEach((btn) => {
      btn.addEventListener("mousedown", (event) => {
        event.preventDefault();
        const idx = Number(btn.dataset.suggestionIndex);
        queryInput.value = EXAMPLE_QUERIES[idx] ?? "";
        placeholderActive = false;
        suggestionsDropdown.hidden = true;
        queryInput.focus();
      });
    });
  }
  renderSuggestions();

  queryInput.addEventListener("focus", () => {
    if (!queryInput.value) suggestionsDropdown.hidden = false;
  });
  queryInput.addEventListener("input", () => {
    placeholderActive = false;
    suggestionsDropdown.hidden = queryInput.value.length > 0;
  });
  queryInput.addEventListener("blur", () => {
    setTimeout(() => {
      suggestionsDropdown.hidden = true;
    }, 150);
  });

  // ── Step transitions ─────────────────────────────────────────────────

  function showQueryStep(): void {
    stepQuery.hidden = false;
    stepReview.hidden = true;
    resultsSection.hidden = true;
    stopPolling();
    activeJobId = null;
  }

  function showReviewStep(): void {
    stepQuery.hidden = true;
    stepReview.hidden = false;
    reviewLoading.hidden = false;
    reviewFields.hidden = true;
  }

  reviewButton.addEventListener("click", async () => {
    const query = queryInput.value.trim();
    if (!query) return;
    pageError.hidden = true;
    showReviewStep();
    try {
      const parsed = await authFetch<ParsedFilters>("/leads/parse-query", {
        method: "POST",
        body: JSON.stringify({ query }),
      });
      latestParsed = parsed;
      fieldCampaignName.value = parsed.campaignName;
      keywordsInput.setValues(parsed.searchKeywords);
      industriesInput.setValues(parsed.targetIndustries);
      rolesInput.setValues(parsed.personTitles);
      senioritySelect?.setValues(parsed.personSeniorities);
      companySizeSelect?.setValues([]);
      deptSelected = new Set();
      renderDeptList(deptSearchInput.value);
      updateDeptSummary();
      fieldLocation.value = parsed.location;
      fieldRevenueMin.value = "";
      fieldRevenueMax.value = "";
      exclusionsInput.setValues([]);
      reviewLoading.hidden = true;
      reviewFields.hidden = false;
    } catch (err) {
      showQueryStep();
      handleError(err);
    }
  });

  reviewBack.addEventListener("click", showQueryStep);

  // ── Search: start, poll, cancel, get more ───────────────────────────

  function setRunningUi(running: boolean): void {
    runSearchButton.textContent = running ? "Stop" : "Search →";
    runSearchButton.classList.toggle("bg-lime", !running);
    runSearchButton.classList.toggle("hover:bg-lime-dark", !running);
    runSearchButton.classList.toggle("text-navy-dark", !running);
    runSearchButton.classList.toggle("bg-red-500", running);
    runSearchButton.classList.toggle("hover:bg-red-600", running);
    runSearchButton.classList.toggle("text-white", running);
  }

  function stopPolling(): void {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = undefined;
  }

  async function pollJob(jobId: string, isFirstTick: boolean): Promise<void> {
    let job: SearchJob;
    try {
      job = await authFetch<SearchJob>(`/leads/ai-search/${jobId}`);
    } catch (err) {
      stopPolling();
      activeJobId = null;
      setRunningUi(false);
      handleError(err);
      return;
    }

    resultsSection.hidden = false;

    if (isFirstTick) {
      searchResultsView.render(jobId, job.results, false, `${slugifyFilename(job.query)}.csv`, () => {
        setRunningUi(true);
        startPolling(jobId);
      });
    } else {
      searchResultsView.updateResults(job.results);
    }

    if (job.status === "FAILED") {
      pageError.textContent = "Something went wrong running that search. Please try again.";
      pageError.hidden = false;
    }

    if (job.status !== "RUNNING") {
      stopPolling();
      activeJobId = null;
      setRunningUi(false);
      searchResultsView.setGetMoreVisible(job.status === "COMPLETED");
      try {
        updateCredits(await authFetch<CreditsResponse>("/leads/credits"));
      } catch {
        // Non-fatal — the credits label just stays at its last known value.
      }
    } else {
      searchResultsView.setGetMoreVisible(false);
    }
  }

  function startPolling(jobId: string): void {
    activeJobId = jobId;
    stopPolling();
    pollTimer = setInterval(() => void pollJob(jobId, false), 1500);
    void pollJob(jobId, true);
  }

  runSearchButton.addEventListener("click", async () => {
    if (activeJobId) {
      try {
        await authFetch(`/leads/ai-search/${activeJobId}/cancel`, { method: "POST" });
      } catch (err) {
        handleError(err);
      }
      return;
    }

    const campaignName = fieldCampaignName.value.trim() || queryInput.value.trim().slice(0, 200);
    if (!campaignName) return;

    pageError.hidden = true;
    setRunningUi(true);
    resultsSection.hidden = false;

    const revenueMin = fieldRevenueMin.value ? Number(fieldRevenueMin.value) : undefined;
    const revenueMax = fieldRevenueMax.value ? Number(fieldRevenueMax.value) : undefined;

    try {
      const { jobId } = await authFetch<{ jobId: string }>("/leads/ai-search", {
        method: "POST",
        body: JSON.stringify({
          campaignName,
          searchKeywords: keywordsInput.getValues(),
          targetIndustries: industriesInput.getValues(),
          personTitles: rolesInput.getValues(),
          personSeniorities: senioritySelect?.getValues() ?? [],
          personFunctions: getDeptPersonFunctions(),
          location: fieldLocation.value.trim() || undefined,
          companySizeRanges: companySizeSelect?.getValues() ?? [],
          revenueMin,
          revenueMax,
          exclusions: exclusionsInput.getValues(),
          personName: latestParsed?.personName || undefined,
          personOrganization: latestParsed?.personOrganization || undefined,
        }),
      });
      startPolling(jobId);
    } catch (err) {
      setRunningUi(false);
      handleError(err);
    }
  });

  // ── History ──────────────────────────────────────────────────────────

  function historyRowHtml(item: HistoryItem): string {
    const date = new Date(item.createdAt).toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
    const statusText =
      item.status === "RUNNING"
        ? "In progress"
        : item.status.charAt(0) + item.status.slice(1).toLowerCase();
    return `
      <div class="flex items-center gap-2 px-4 py-3.5 transition-colors hover:bg-bg-soft">
        <button type="button" data-job-id="${escapeHtml(item.id)}" class="history-row-open min-w-0 flex-1 text-left">
          <p class="truncate text-[13px] font-medium text-ink">${escapeHtml(item.query)}</p>
          <p class="mt-0.5 text-[12px] text-ink-faint">${date} · ${item.resultCount} result${item.resultCount === 1 ? "" : "s"}</p>
        </button>
        <span class="shrink-0 rounded-full bg-bg-soft px-2.5 py-1 text-[12px] font-medium text-ink-soft">${statusText}</span>
        <button
          type="button"
          data-export-job-id="${escapeHtml(item.id)}"
          data-export-name="${escapeHtml(item.query)}"
          title="Export CSV"
          aria-label="Export CSV"
          class="history-row-export shrink-0 inline-flex items-center gap-1 rounded-lg border border-line px-2.5 py-1.5 text-[12px] font-medium text-ink-soft transition-colors hover:border-ink-faint hover:text-ink"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Export
        </button>
      </div>`;
  }

  async function exportHistoryRow(jobId: string, name: string): Promise<void> {
    try {
      const job = await authFetch<SearchJob>(`/leads/ai-search/${jobId}`);
      exportResultsCsv(job.results, `${slugifyFilename(name)}.csv`);
    } catch (err) {
      handleError(err);
    }
  }

  async function loadHistory(): Promise<void> {
    try {
      const items = await authFetch<HistoryItem[]>("/leads/ai-search/history");
      if (items.length === 0) {
        historyList.innerHTML = `<p class="px-4 py-8 text-center text-[13px] text-ink-faint">No searches yet — run one from the Search tab.</p>`;
        return;
      }
      historyList.innerHTML = items.map(historyRowHtml).join("");
      historyList.querySelectorAll<HTMLButtonElement>(".history-row-open").forEach((row) => {
        row.addEventListener("click", () => {
          const jobId = row.dataset.jobId;
          if (jobId) void openHistoryDetail(jobId);
        });
      });
      historyList.querySelectorAll<HTMLButtonElement>(".history-row-export").forEach((btn) => {
        btn.addEventListener("click", () => {
          const jobId = btn.dataset.exportJobId;
          const name = btn.dataset.exportName ?? "lead-finder-results";
          if (jobId) void exportHistoryRow(jobId, name);
        });
      });
    } catch (err) {
      handleError(err);
    }
  }

  async function openHistoryDetail(jobId: string): Promise<void> {
    try {
      const job = await authFetch<SearchJob>(`/leads/ai-search/${jobId}`);
      historyDetailQuery.textContent = job.query;
      historyResultsView.render(jobId, job.results, job.status === "COMPLETED", `${slugifyFilename(job.query)}.csv`, () => {
        void openHistoryDetail(jobId);
      });
      historyList.hidden = true;
      historyDetail.hidden = false;
    } catch (err) {
      handleError(err);
    }
  }

  historyBack.addEventListener("click", () => {
    historyDetail.hidden = true;
    historyList.hidden = false;
  });

  // ── Init ─────────────────────────────────────────────────────────────

  function showCreditsBanner(): void {
    const params = new URLSearchParams(window.location.search);
    const creditsParam = params.get("credits");
    const tierParam = params.get("tier");
    if (creditsParam === "success") {
      creditsBanner.textContent = "Credits added — ready to search.";
      creditsBanner.hidden = false;
    } else if (creditsParam === "cancelled") {
      creditsBanner.textContent = "Checkout cancelled — no credits were purchased.";
      creditsBanner.hidden = false;
    } else if (tierParam === "success") {
      creditsBanner.textContent = "Plan updated — your credits will land shortly.";
      creditsBanner.hidden = false;
    } else if (tierParam === "cancelled") {
      creditsBanner.textContent = "Checkout cancelled — your plan wasn't changed.";
      creditsBanner.hidden = false;
    }
  }

  async function init(): Promise<void> {
    if (!(await ensureAuthenticated())) {
      redirectToSignin();
      return;
    }
    showCreditsBanner();
    try {
      const [credits] = await Promise.all([
        authFetch<CreditsResponse>("/leads/credits"),
        loadCreditPack(),
        loadTaxonomy(),
      ]);
      updateCredits(credits);
      loading.hidden = true;
      content.hidden = false;
      void runPlaceholderCycle();
    } catch (err) {
      loading.hidden = true;
      handleError(err);
    }
  }

  init();
</script>
