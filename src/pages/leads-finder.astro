  function renderPlanStatusLine(status: LeadFinderStatus, tiers: LeadFinderTier[]): void {
    const tierName = tiers.find((t) => t.slug === status.tierSlug)?.name ?? "Free";
    if (status.status === "NONE") {
      planStatusLine.textContent = "You're on the Free plan.";
      return;
    }
    const periodEnd = status.currentPeriodEnd
      ? new Date(status.currentPeriodEnd).toLocaleDateString()
      : null;
    if (status.cancelAtPeriodEnd) {
      planStatusLine.textContent = `You're on ${tierName} — cancels ${periodEnd ?? "at the end of this period"}.`;
    } else {
      planStatusLine.textContent = periodEnd
        ? `You're on ${tierName} — renews ${periodEnd}.`
