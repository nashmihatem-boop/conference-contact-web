      <div class="relative rounded-2xl border-2 ${isCurrent ? "border-lime" : isPopular ? "border-amber-400" : "border-line"} p-5">
        ${isPopular ? `<span class="absolute -top-3 right-4 rounded-full bg-amber-400 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-navy-dark">Popular</span>` : ""}
        <p class="text-[13px] font-semibold text-ink-faint">${escapeHtml(tier.name)}</p>
