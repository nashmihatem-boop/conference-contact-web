        <div class="flex gap-2">
          <button type="button" data-bulk-approve class="rounded-full bg-lime px-3 py-1 text-[12px] font-semibold text-navy-dark">Approve</button>
          <button type="button" data-bulk-skip class="rounded-full bg-white/10 px-3 py-1 text-[12px] font-semibold text-white transition-colors hover:bg-white/20">Skip</button>
