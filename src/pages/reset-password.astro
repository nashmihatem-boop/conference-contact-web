---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Set a new password — conference.contact">
  <div class="flex min-h-screen items-center justify-center bg-bg-soft px-6 py-16">
    <div class="w-full max-w-sm rounded-2xl bg-white p-8">
      <div class="text-center">
        <a href="/" class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight text-navy">
          <svg viewBox="0 0 96 96" class="h-7 w-7 shrink-0" aria-hidden="true">
            <rect width="96" height="96" rx="26" fill="#C3DB42" />
            <rect x="16" y="26" width="64" height="44" rx="9" fill="#0D1448" />
            <circle cx="33" cy="44" r="8" fill="#C3DB42" />
            <path d="M 22 62 a 11 11 0 0 1 22 0 z" fill="#C3DB42" />
            <rect x="49" y="38" width="23" height="5.5" rx="2.75" fill="#C3DB42" />
            <rect x="49" y="49" width="16" height="5" rx="2.5" fill="#FFFFFF" opacity="0.85" />
            <circle cx="72" cy="66" r="13" fill="#C3DB42" />
            <path d="M 66.5 66 l 4 4 l 7.5 -8.5" stroke="#0D1448" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
          <span>conference<span class="text-lime">.</span>contact</span>
        </a>
      </div>

      <h1 id="reset-heading" class="mt-8 text-center font-display text-2xl font-extrabold tracking-tight text-ink">
        Set a new password
      </h1>

      <div id="reset-error" hidden class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>

      <form id="reset-form" class="mt-6 flex flex-col gap-4">
        <div>
          <label for="reset-password-input" class="mb-1.5 block text-[13px] font-semibold text-ink">New password</label>
          <input
            id="reset-password-input"
            name="newPassword"
            type="password"
            required
            minlength="8"
            placeholder="Create a new password"
            class="w-full rounded-xl border-2 border-line px-4 py-3 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
          />
        </div>
        <button
          id="reset-submit"
          type="submit"
          class="mt-1 rounded-xl bg-navy py-3.5 text-center text-[15px] font-semibold text-white transition-colors hover:bg-navy-mid disabled:cursor-not-allowed disabled:opacity-60"
        >
          Update password →
        </button>
      </form>

      <div id="reset-success" hidden class="mt-6 rounded-xl border border-line bg-lime-tint p-5 text-center">
        <p class="text-[13px] leading-relaxed text-ink">Password updated.</p>
        <a href="/signin" class="mt-4 block rounded-xl bg-navy py-3 text-center text-[14px] font-semibold text-white transition-colors hover:bg-navy-mid">
          Sign in →
        </a>
      </div>

      <div id="reset-no-token" hidden class="mt-6 rounded-xl border border-red-200 bg-red-50 p-5 text-center text-[13px] text-red-700">
        This link is missing its reset token. Request a new one from the
        <a href="/forgot-password" class="font-semibold underline">forgot password</a> page.
      </div>
    </div>
  </div>
</Layout>

<script>
  import { apiFetch, ApiError } from "../lib/api";

  const form = document.querySelector<HTMLFormElement>("#reset-form")!;
  const submitButton = document.querySelector<HTMLButtonElement>("#reset-submit")!;
  const errorBanner = document.querySelector<HTMLDivElement>("#reset-error")!;
  const successState = document.querySelector<HTMLDivElement>("#reset-success")!;
  const noTokenState = document.querySelector<HTMLDivElement>("#reset-no-token")!;
  const heading = document.querySelector<HTMLHeadingElement>("#reset-heading")!;

  const token = new URLSearchParams(window.location.search).get("token");

  if (!token) {
    form.hidden = true;
    noTokenState.hidden = false;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!token) return;
    errorBanner.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = "Updating…";

    const data = new FormData(form);
    try {
      await apiFetch<{ message: string }>("/auth/reset-password", {
        method: "POST",
        body: JSON.stringify({ token, newPassword: data.get("newPassword") }),
      });
      form.hidden = true;
      heading.hidden = true;
      successState.hidden = false;
    } catch (err) {
      errorBanner.textContent =
        err instanceof ApiError ? err.message : "This link may have expired or already been used.";
      errorBanner.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = "Update password →";
    }
  });
</script>
