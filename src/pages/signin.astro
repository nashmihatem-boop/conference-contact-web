---
import Layout from "../layouts/Layout.astro";

const highlights = [
  {
    stat: "24,931",
    label: "Verified contacts — real name, title, company, and email, hand-checked across 6 company types.",
  },
  {
    stat: "10",
    label: "Major B2B conferences covered, including Affiliate Summit East/West, Leadscon, and MAU Vegas.",
  },
];
---

<Layout
  title="Sign in to your account — conference.contact"
  description="Sign in to search the verified conference contact directory and run AI-powered lead searches."
>
  <div class="grid min-h-screen lg:grid-cols-2">
    <div class="relative hidden flex-col justify-between overflow-hidden bg-navy p-10 lg:flex">
      <div class="navy-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <a href="/" class="relative flex items-center gap-1.5 text-[14px] text-white/70 transition-colors hover:text-white">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to home
      </a>

      <div class="relative flex flex-col gap-4">
        {
          highlights.map((h) => (
            <figure class="rounded-2xl border border-white/15 bg-white/10 p-5 backdrop-blur-sm">
              <span class="block font-display text-3xl font-extrabold text-lime">{h.stat}</span>
              <figcaption class="mt-1.5 text-[13px] leading-relaxed text-white/80">{h.label}</figcaption>
            </figure>
          ))
        }
      </div>

      <div />
    </div>

    <div class="flex items-center justify-center px-6 py-16">
      <div class="w-full max-w-sm">
        <a href="/" class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight text-navy">
          <svg viewBox="0 0 96 96" class="h-7 w-7 shrink-0" aria-hidden="true">
            <rect width="96" height="96" rx="26" fill="#C3DB42" />
            <rect x="16" y="26" width="64" height="44" rx="9" fill="#0D1448" />
            <circle cx="33" cy="44" r="8" fill="#C3DB42" />
            <path d="M 22 62 a 11 11 0 0 1 22 0 z" fill="#C3DB42" />
            <rect x="49" y="38" width="23" height="5.5" rx="2.75" fill="#C3DB42" />
            <rect x="49" y="49" width="16" height="5" rx="2.5" fill="#FFFFFF" opacity="0.85" />
            <circle cx="72" cy="66" r="13" fill="#C3DB42" />
            <path d="M 66.5 66 l 4 4 l 7.5 -8.5" stroke="#0D1448" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
          <span>conference<span class="text-lime">.</span>contact</span>
        </a>

        <h1 id="signin-heading" class="mt-8 font-display text-3xl font-extrabold tracking-tight text-ink">Welcome back</h1>
        <p id="signin-intro" class="mt-2 text-[14px] text-ink-soft">
          No account? <a href="/signup" class="font-semibold text-navy hover:text-navy-mid">Sign up</a>
        </p>

        <div id="signin-error" hidden class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>

        <form id="signin-form" class="mt-7 flex flex-col gap-4">
          <div>
            <label for="signin-email" class="mb-1.5 block text-[13px] font-semibold text-ink">Email</label>
            <input
              id="signin-email"
              name="email"
              type="email"
              required
              placeholder="you@company.com"
              class="w-full rounded-xl border-2 border-line px-4 py-3 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
            />
          </div>
          <div>
            <label for="signin-password" class="mb-1.5 block text-[13px] font-semibold text-ink">Password</label>
            <div class="relative">
              <input
                id="signin-password"
                name="password"
                type="password"
                required
                placeholder="Your password"
                class="w-full rounded-xl border-2 border-line px-4 py-3 pr-11 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
              />
              <button
                type="button"
                id="signin-password-toggle"
                aria-label="Show password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-faint hover:text-ink-soft"
              >
                <svg id="signin-password-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg id="signin-password-eye-off" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M6.61 6.61A18.5 18.5 0 0 0 1 12s4 8 11 8a9.26 9.26 0 0 0 5.39-1.61"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <button
            id="signin-submit"
            type="submit"
            class="mt-1 rounded-xl bg-navy py-3.5 text-center text-[15px] font-semibold text-white transition-colors hover:bg-navy-mid disabled:cursor-not-allowed disabled:opacity-60"
          >
            Sign in →
          </button>
        </form>

        <form id="code-form" hidden class="mt-7 flex flex-col gap-4">
          <h2 id="code-heading" class="font-display text-2xl font-extrabold tracking-tight text-ink">Check your email</h2>
          <p id="code-instructions" class="-mt-2 text-[13px] leading-relaxed text-ink-soft">
            We just sent a 6-digit code to your inbox — enter it below to finish signing in.
          </p>
          <div>
            <label for="code-input" class="mb-1.5 block text-[13px] font-semibold text-ink">Verification code</label>
            <input
              id="code-input"
              name="code"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              required
              minlength="6"
              maxlength="6"
              placeholder="123456"
              class="w-full rounded-xl border-2 border-line px-4 py-3 text-center text-[20px] tracking-[0.3em] text-ink placeholder:tracking-normal placeholder:text-ink-faint focus:border-navy focus:outline-none"
            />
          </div>
          <button
            id="code-submit"
            type="submit"
            class="mt-1 rounded-xl bg-navy py-3.5 text-center text-[15px] font-semibold text-white transition-colors hover:bg-navy-mid disabled:cursor-not-allowed disabled:opacity-60"
          >
            Verify →
          </button>
          <p id="code-resend-line" class="text-center text-[13px] text-ink-soft">
            Didn't get a code?
            <button
              id="code-resend"
              type="button"
              disabled
              class="font-semibold text-navy hover:text-navy-mid disabled:cursor-not-allowed disabled:text-ink-faint"
            >
              Resend code
            </button>
          </p>
          <button
            id="code-back"
            type="button"
            class="text-center text-[13px] font-medium text-ink-soft hover:text-ink"
          >
            ← Back
          </button>
        </form>

        <a id="signin-forgot" href="/forgot-password" class="mt-5 block text-center text-[13px] font-medium text-navy hover:text-navy-mid">
          Forgot password?
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { apiFetch, ApiError } from "../lib/api";
  import { saveAccessToken, safeRedirectTarget } from "../lib/session";

  interface LoginResponse {
    requiresVerification: boolean;
    accessToken?: string;
    method?: "EMAIL_CODE" | "TOTP";
    challengeToken?: string;
  }

  const loginForm = document.querySelector<HTMLFormElement>("#signin-form")!;
  const loginSubmit = document.querySelector<HTMLButtonElement>("#signin-submit")!;
  const errorBanner = document.querySelector<HTMLDivElement>("#signin-error")!;
  const heading = document.querySelector<HTMLHeadingElement>("#signin-heading")!;
  const intro = document.querySelector<HTMLParagraphElement>("#signin-intro")!;
  const forgotLink = document.querySelector<HTMLAnchorElement>("#signin-forgot")!;

  const passwordInput = document.querySelector<HTMLInputElement>("#signin-password")!;
  const passwordToggle = document.querySelector<HTMLButtonElement>("#signin-password-toggle")!;
  const passwordEye = document.querySelector<SVGElement>("#signin-password-eye")!;
  const passwordEyeOff = document.querySelector<SVGElement>("#signin-password-eye-off")!;

  passwordToggle.addEventListener("click", () => {
    const isHidden = passwordInput.type === "password";
    passwordInput.type = isHidden ? "text" : "password";
    passwordEye.classList.toggle("hidden", isHidden);
    passwordEyeOff.classList.toggle("hidden", !isHidden);
    passwordToggle.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
  });

  const codeForm = document.querySelector<HTMLFormElement>("#code-form")!;
  const codeHeading = document.querySelector<HTMLHeadingElement>("#code-heading")!;
  const codeInstructions = document.querySelector<HTMLParagraphElement>("#code-instructions")!;
  const codeSubmit = document.querySelector<HTMLButtonElement>("#code-submit")!;
  const codeBack = document.querySelector<HTMLButtonElement>("#code-back")!;
  const codeResend = document.querySelector<HTMLButtonElement>("#code-resend")!;
  const codeResendLine = document.querySelector<HTMLParagraphElement>("#code-resend-line")!;

  let pendingChallengeToken: string | null = null;
  let resendInterval: ReturnType<typeof setInterval> | null = null;

  const RESEND_COOLDOWN_SECONDS = 30;

  function startResendCooldown() {
    if (resendInterval) clearInterval(resendInterval);
    let secondsLeft = RESEND_COOLDOWN_SECONDS;
    codeResend.disabled = true;
    codeResend.textContent = `Resend code (${secondsLeft}s)`;
    resendInterval = setInterval(() => {
      secondsLeft -= 1;
      if (secondsLeft <= 0) {
        clearInterval(resendInterval!);
        resendInterval = null;
        codeResend.disabled = false;
        codeResend.textContent = "Resend code";
      } else {
        codeResend.textContent = `Resend code (${secondsLeft}s)`;
      }
    }, 1000);
  }

  function stopResendCooldown() {
    if (resendInterval) clearInterval(resendInterval);
    resendInterval = null;
  }

  function showError(message: string) {
    if (message.startsWith("This account is not active")) {
      errorBanner.innerHTML = `This account is not active. <a href="/contact?reason=account_issue" class="font-semibold underline">Contact us</a> if you believe this is a mistake.`;
    } else {
      errorBanner.textContent = message;
    }
    errorBanner.hidden = false;
  }

  function showCodeStep(method: "EMAIL_CODE" | "TOTP", challengeToken: string) {
    pendingChallengeToken = challengeToken;
    const isEmailCode = method === "EMAIL_CODE";
    codeHeading.textContent = isEmailCode ? "Check your email" : "Enter your code";
    codeInstructions.textContent = isEmailCode
      ? "We just sent a 6-digit code to your inbox — enter it below to finish signing in."
      : "Enter the 6-digit code from your authenticator app.";
    codeResendLine.hidden = !isEmailCode;
    loginForm.hidden = true;
    heading.hidden = true;
    intro.hidden = true;
    forgotLink.hidden = true;
    codeForm.hidden = false;
    if (isEmailCode) startResendCooldown();
  }

  function goToAccount() {
    const redirect = new URLSearchParams(window.location.search).get("redirect");
    window.location.href = safeRedirectTarget(redirect);
  }

  loginForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBanner.hidden = true;
    loginSubmit.disabled = true;
    loginSubmit.textContent = "Signing in…";

    const data = new FormData(loginForm);
    try {
      const result = await apiFetch<LoginResponse>("/auth/login", {
        method: "POST",
        body: JSON.stringify({
          email: data.get("email"),
          password: data.get("password"),
        }),
      });

      if (!result.requiresVerification && result.accessToken) {
        saveAccessToken(result.accessToken);
        goToAccount();
        return;
      }

      if (result.requiresVerification && result.method && result.challengeToken) {
        showCodeStep(result.method, result.challengeToken);
      }
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Something went wrong. Please try again.");
    } finally {
      loginSubmit.disabled = false;
      loginSubmit.textContent = "Sign in →";
    }
  });

  codeForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBanner.hidden = true;
    if (!pendingChallengeToken) return;
    codeSubmit.disabled = true;
    codeSubmit.textContent = "Verifying…";

    const data = new FormData(codeForm);
    try {
      const result = await apiFetch<{ accessToken: string }>("/auth/login/verify", {
        method: "POST",
        body: JSON.stringify({
          challengeToken: pendingChallengeToken,
          code: data.get("code"),
        }),
      });
      saveAccessToken(result.accessToken);
      goToAccount();
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Something went wrong. Please try again.");
      codeSubmit.disabled = false;
      codeSubmit.textContent = "Verify →";
    }
  });

  codeResend.addEventListener("click", async () => {
    codeResend.disabled = true;
    errorBanner.hidden = true;
    const data = new FormData(loginForm);
    try {
      const result = await apiFetch<LoginResponse>("/auth/login", {
        method: "POST",
        body: JSON.stringify({
          email: data.get("email"),
          password: data.get("password"),
        }),
      });
      if (result.requiresVerification && result.challengeToken) {
        pendingChallengeToken = result.challengeToken;
        startResendCooldown();
      }
    } catch (err) {
      showError(err instanceof ApiError ? err.message : "Couldn't resend the code. Please try again.");
      startResendCooldown();
    }
  });

  codeBack.addEventListener("click", () => {
    pendingChallengeToken = null;
    stopResendCooldown();
    errorBanner.hidden = true;
    codeForm.hidden = true;
    loginForm.hidden = false;
    heading.hidden = false;
    intro.hidden = false;
    forgotLink.hidden = false;
  });
</script>
