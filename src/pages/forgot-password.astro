---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Reset your password — conference.contact">
  <div class="flex min-h-screen items-center justify-center bg-bg-soft px-6 py-16">
    <div class="w-full max-w-sm rounded-2xl bg-white p-8">
      <div class="text-center">
        <a href="/" class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight text-navy">
          <svg viewBox="0 0 96 96" class="h-7 w-7 shrink-0" aria-hidden="true">
            <rect width="96" height="96" rx="26" fill="#C3DB42" />
            <rect x="16" y="26" width="64" height="44" rx="9" fill="#0D1448" />
            <circle cx="33" cy="44" r="8" fill="#C3DB42" />
            <path d="M 22 62 a 11 11 0 0 1 22 0 z" fill="#C3DB42" />
            <rect x="49" y="38" width="23" height="5.5" rx="2.75" fill="#C3DB42" />
            <rect x="49" y="49" width="16" height="5" rx="2.5" fill="#FFFFFF" opacity="0.85" />
            <circle cx="72" cy="66" r="13" fill="#C3DB42" />
            <path d="M 66.5 66 l 4 4 l 7.5 -8.5" stroke="#0D1448" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
          <span>conference<span class="text-lime">.</span>contact</span>
        </a>
      </div>

      <h1 id="forgot-heading" class="mt-8 text-center font-display text-2xl font-extrabold tracking-tight text-ink">
        Forgot your password?
      </h1>
      <p id="forgot-intro" class="mt-2 text-center text-[14px] text-ink-soft">
        Enter your email and we'll send you a reset link.
      </p>

      <div id="forgot-error" hidden class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>

      <form id="forgot-form" class="mt-6 flex flex-col gap-4">
        <div>
          <label for="forgot-email" class="mb-1.5 block text-[13px] font-semibold text-ink">Email</label>
          <input
            id="forgot-email"
            name="email"
            type="email"
            required
            placeholder="you@company.com"
            class="w-full rounded-xl border-2 border-line px-4 py-3 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
          />
        </div>
        <button
          id="forgot-submit"
          type="submit"
          class="mt-1 rounded-xl bg-navy py-3.5 text-center text-[15px] font-semibold text-white transition-colors hover:bg-navy-mid disabled:cursor-not-allowed disabled:opacity-60"
        >
          Send reset link →
        </button>
      </form>

      <div id="forgot-success" hidden class="mt-6 rounded-xl border border-line bg-lime-tint p-5 text-center">
        <p class="text-[13px] leading-relaxed text-ink">
          If an account with that email exists, we've sent a reset link — check your inbox.
        </p>
      </div>

      <a href="/signin" class="mt-5 block text-center text-[13px] font-medium text-navy hover:text-navy-mid">
        ← Back to sign in
      </a>
    </div>
  </div>
</Layout>

<script>
  import { apiFetch, ApiError } from "../lib/api";

  const form = document.querySelector<HTMLFormElement>("#forgot-form")!;
  const submitButton = document.querySelector<HTMLButtonElement>("#forgot-submit")!;
  const errorBanner = document.querySelector<HTMLDivElement>("#forgot-error")!;
  const successState = document.querySelector<HTMLDivElement>("#forgot-success")!;
  const heading = document.querySelector<HTMLHeadingElement>("#forgot-heading")!;
  const intro = document.querySelector<HTMLParagraphElement>("#forgot-intro")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBanner.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = "Sending…";

    const data = new FormData(form);
    try {
      await apiFetch<{ message: string }>("/auth/forgot-password", {
        method: "POST",
        body: JSON.stringify({ email: data.get("email") }),
      });
      form.hidden = true;
      heading.hidden = true;
      intro.hidden = true;
      successState.hidden = false;
    } catch (err) {
      errorBanner.textContent =
        err instanceof ApiError ? err.message : "Something went wrong. Please try again.";
      errorBanner.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = "Send reset link →";
    }
  });
</script>
