---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Wave from "../components/Wave.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Contact us — conference.contact"
  description="Get in touch with the conference.contact team for billing questions, data corrections, or support with the directory and Lead Finder."
>
  <Nav />

  <div class="relative overflow-hidden bg-navy px-5 pb-16 pt-14 sm:px-8 sm:pt-20">
    <div class="navy-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-md">
      <p class="text-[13px] font-semibold uppercase tracking-wide text-lime">Support</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Contact us</h1>
      <p class="mt-2 text-[14px] text-white/60">
        Billing question, account issue, or a record you'd like removed — tell us what's going on and we'll get back to you.
      </p>
    </div>
  </div>
  <Wave before="var(--color-navy)" after="var(--color-bg-soft)" />

  <div class="bg-bg-soft px-5 pt-6 pb-16 sm:px-8 sm:pt-8">
    <div class="mx-auto max-w-md">
      <div id="contact-error" hidden class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] text-red-700"></div>
      <div id="contact-success" hidden class="mb-5 rounded-xl border border-lime/30 bg-lime-tint px-4 py-3 text-[13px] text-navy">
        Thanks — we'll get back to you soon.
      </div>

      <form id="contact-form" class="rounded-2xl bg-white p-6 shadow-[0_25px_60px_-30px_rgba(11,20,84,0.4)] sm:p-7 flex flex-col gap-4">
      <div>
        <label for="contact-name" class="mb-1.5 block text-[13px] font-semibold text-ink">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          maxlength="200"
          placeholder="Jane Smith"
          class="w-full rounded-xl border-2 border-line px-4 py-3 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
        />
      </div>
      <div>
        <label for="contact-email" class="mb-1.5 block text-[13px] font-semibold text-ink">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          maxlength="200"
          placeholder="you@company.com"
          class="w-full rounded-xl border-2 border-line px-4 py-3 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
        />
      </div>
      <div>
        <label for="contact-reason" class="mb-1.5 block text-[13px] font-semibold text-ink">Reason</label>
        <select
          id="contact-reason"
          name="reason"
          required
          class="w-full rounded-xl border-2 border-line bg-white px-4 py-3 text-[14px] text-ink focus:border-navy focus:outline-none"
        >
          <option value="BILLING">Billing question</option>
          <option value="ACCOUNT_ISSUE">Account issue</option>
          <option value="REMOVE_RECORD">Remove a directory record</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
      <div>
        <label for="contact-message" class="mb-1.5 block text-[13px] font-semibold text-ink">Message</label>
        <textarea
          id="contact-message"
          name="message"
          required
          maxlength="5000"
          rows="5"
          placeholder="What's going on?"
          class="w-full resize-none rounded-xl border-2 border-line px-4 py-3 text-[14px] text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
        ></textarea>
      </div>

      <button
        id="contact-submit"
        type="submit"
        class="mt-1 rounded-xl bg-lime py-3.5 text-center text-[15px] font-semibold text-navy-dark transition-colors hover:bg-lime-dark disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send message →
      </button>
      </form>
    </div>
  </div>
  <Footer />
</Layout>

<script>
  import { apiFetch, ApiError } from "../lib/api";

  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const reasonSelect = document.querySelector<HTMLSelectElement>("#contact-reason")!;
  const submitButton = document.querySelector<HTMLButtonElement>("#contact-submit")!;
  const errorBanner = document.querySelector<HTMLDivElement>("#contact-error")!;
  const successBanner = document.querySelector<HTMLDivElement>("#contact-success")!;

  const REASON_PARAM_MAP: Record<string, string> = {
    billing: "BILLING",
    account_issue: "ACCOUNT_ISSUE",
    remove_record: "REMOVE_RECORD",
  };
  const requestedReason = new URLSearchParams(window.location.search).get("reason");
  if (requestedReason && REASON_PARAM_MAP[requestedReason]) {
    reasonSelect.value = REASON_PARAM_MAP[requestedReason];
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBanner.hidden = true;
    successBanner.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = "Sending…";

    const data = new FormData(form);
    try {
      await apiFetch<{ message: string }>("/contact", {
        method: "POST",
        body: JSON.stringify({
          name: data.get("name"),
          email: data.get("email"),
          reason: data.get("reason"),
          message: data.get("message"),
        }),
      });
      form.hidden = true;
      successBanner.hidden = false;
    } catch (err) {
      errorBanner.textContent =
        err instanceof ApiError ? err.message : "Something went wrong. Please try again.";
      errorBanner.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = "Send message →";
    }
  });
</script>
