---
const stats = [
  {
    number: "21,744",
    label: "Verified contacts",
    detail: "Real name, title, company, and email — hand-checked, not scraped.",
  },
  {
    number: "8",
    label: "B2B conferences covered",
    detail: "Affiliate Summit East & West, Leadscon, MAU Vegas, and more.",
  },
  {
    number: "6",
    label: "Company types indexed",
    detail: "Advertisers, ad networks, affiliates, agencies, and solution providers.",
  },
];
---

<section class="bg-white px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p class="text-[13px] font-semibold uppercase tracking-wide text-navy">By the numbers</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        What's actually in the directory.
      </h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <figure class="rounded-2xl bg-bg-soft p-6">
            <span class="block font-display text-4xl font-extrabold text-navy">{stat.number}</span>
            <figcaption class="mt-2">
              <span class="block text-[14px] font-semibold text-ink">{stat.label}</span>
              <span class="mt-1 block text-[13px] leading-relaxed text-ink-soft">{stat.detail}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
