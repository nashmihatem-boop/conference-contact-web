---
import Wave from "./Wave.astro";

const chips = ["Affiliate Summit East 2026", "Leadscon 2026", "MAU Vegas 2026"];
---

<section id="top" class="relative overflow-hidden bg-navy px-5 pt-16 pb-20 sm:px-8 sm:pt-24 sm:pb-28">
  <div class="navy-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-3xl text-center">
    <h1 class="font-display text-[2.5rem] font-extrabold leading-[1.08] tracking-tight text-white sm:text-6xl">
      Stop Digging For Conference Contacts.
      <br />
      <span class="text-lime">Start Searching Instead.</span>
    </h1>

    <p class="mx-auto mt-5 max-w-xl text-[17px] leading-relaxed text-white/70">
      conference.contact is a hand-verified directory of who actually shows up
      to the B2B conference circuit — ad networks, advertisers, affiliates,
      agencies, and solution providers. Search once, get the full contact card.
    </p>

    <form id="hero-search-form" class="mx-auto mt-9 flex max-w-xl items-center gap-2 rounded-full bg-white p-1.5 pl-5 shadow-xl shadow-navy-dark/30" data-static="true">
      <label class="sr-only" for="hero-search">Search the directory</label>
      <input
        id="hero-search"
        type="text"
        placeholder="Search by name, company, conference, or role…"
        class="w-full bg-transparent text-[15px] text-ink placeholder:text-ink-faint focus:outline-none disabled:opacity-50"
      />
      <button
        type="submit"
        aria-label="Search"
        class="grid shrink-0 h-11 w-11 place-items-center rounded-full bg-navy text-white transition-colors hover:bg-navy-mid disabled:opacity-50"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </form>
    <p id="hero-search-helper" class="mt-3 text-[13px] text-white/50">First preview is on us — no account needed.</p>

    <div id="hero-chips" class="mx-auto mt-6 flex flex-wrap items-center justify-center gap-2">
      {
        chips.map((chip) => (
          <button
            type="button"
            class="hero-chip rounded-full border border-white/25 px-3.5 py-1.5 text-[13px] text-white/80 transition-colors hover:border-lime hover:text-lime"
          >
            {chip}
          </button>
        ))
      }
    </div>

    <div
      id="quota-notice"
      hidden
      class="mx-auto mt-6 max-w-xl rounded-2xl border border-lime/30 bg-white px-6 py-5 text-center"
    >
      <p class="font-bold text-navy">You've used your 3 free searches for today</p>
      <p class="mt-1 text-[13px] text-ink-soft">Unlock unlimited searches and full contact details now.</p>
      <a
        href="#pricing"
        class="mt-4 inline-block rounded-full bg-lime px-6 py-2.5 text-[14px] font-semibold text-navy-dark transition-colors hover:bg-lime-dark"
      >
        Get instant access
      </a>
    </div>
  </div>
</section>
<Wave before="var(--color-navy)" after="var(--color-bg-soft)" />

<script>
  import { isAuthenticated } from "../lib/session";

  const SEARCH_LIMIT = 3;
  let searchCount = 0;
  // Signed-in users already have an account — the free-search paywall exists
  // to convert anonymous visitors, not to nag someone who's already past that.
  const skipLimit = isAuthenticated();

  const form = document.getElementById("hero-search-form") as HTMLFormElement | null;
  const input = document.getElementById("hero-search") as HTMLInputElement | null;
  const button = form?.querySelector("button");
  const helper = document.getElementById("hero-search-helper");
  const chipsWrap = document.getElementById("hero-chips");
  const notice = document.getElementById("quota-notice");

  function registerSearch() {
    searchCount += 1;
    if (!skipLimit && searchCount >= SEARCH_LIMIT) {
      notice?.removeAttribute("hidden");
      helper?.setAttribute("hidden", "true");
      chipsWrap?.setAttribute("hidden", "true");
      input?.setAttribute("disabled", "true");
      button?.setAttribute("disabled", "true");
    }
  }

  function runDemoSearch(query: string): void {
    document.dispatchEvent(new CustomEvent("demo-search", { detail: { query } }));
    const results = document.querySelector("#demo-results-body")?.closest("section");
    results?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (skipLimit || searchCount < SEARCH_LIMIT) {
      registerSearch();
      runDemoSearch(input?.value.trim() ?? "");
    }
  });

  document.querySelectorAll<HTMLButtonElement>(".hero-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const query = chip.textContent?.trim() ?? "";
      if (input) input.value = query;
      if (skipLimit || searchCount < SEARCH_LIMIT) {
        registerSearch();
        runDemoSearch(query);
      }
    });
  });
</script>
