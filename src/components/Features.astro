---
const tags = ["Ad Network", "Advertiser", "Affiliate", "Affiliate Network", "Agency", "Solution Provider"];

const features = [
  {
    title: "Hand-verified, not scraped",
    body: "Every record starts from a public source tied to a real event — a printed program, a speaker roster, a sponsor page — and is checked by a person before it's added.",
    icon: "shield",
  },
  {
    title: "Coverage across the whole floor",
    body: "Ad networks, advertisers, affiliates, agencies, and solution providers — tagged by company type so you know exactly who you're looking at before you reach out.",
    icon: "grid",
  },
  {
    title: "A full record, not just an inbox",
    body: "Verified email, direct-dial where it's public, LinkedIn, and current title and company, all on one card.",
    icon: "card",
  },
  {
    title: "Rechecked on a rolling basis",
    body: "People change jobs mid-quarter. We recheck records on a rolling schedule instead of letting the directory go stale.",
    icon: "refresh",
  },
];

const icons: Record<string, string> = {
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  grid:
    '<rect x="3" y="3" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="13" y="3" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="3" y="13" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="13" y="13" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="2"/>',
  card:
    '<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18M7 15h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  refresh:
    '<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M18 3v4h-4M6 21v-4h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section id="coverage" class="bg-bg-soft px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p class="text-[13px] font-semibold uppercase tracking-wide text-navy">Coverage</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        Every badge on the floor.
      </h2>
      <p class="mt-3 text-[15px] text-ink-soft">Click a category to see who's in it.</p>
    </div>

    <div class="mt-8 flex flex-wrap gap-2" role="list" aria-label="Contact categories tracked">
      {
        tags.map((tag) => (
          <span role="listitem" class="rounded-full bg-white px-4 py-1.5 text-[13px] font-medium text-navy shadow-sm">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        features.map((f) => (
          <div class="rounded-2xl bg-white p-6">
            <span
              class="grid h-11 w-11 place-items-center rounded-xl bg-lime-tint text-navy"
              set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none">${icons[f.icon]}</svg>`}
            />
            <h3 class="mt-4 text-lg font-bold text-ink">{f.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
