---
const included = [
  "Unlimited directory searches",
  "Full contact details — email, phone, LinkedIn",
  "Lead finder — up to ~1,000 fresh leads added every month",
  "Enrichment on demand",
  "Database rechecked on a rolling basis",
  "CSV export",
];

const savings = [
  {
    label: "Flights",
    tag: "Never book one.",
    icon: '<path d="M10.5 20 8 14M10.5 20l2.5-1.5M8 14 3 12.5 4.5 11 8 12l4.8-4.8c1-1 2.6-1 3.6 0 1 1 1 2.6 0 3.6L11.6 15l1 4.5-1.5 1.5-2.6-4M8 14l4.6-4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Hotels",
    tag: "Never check in.",
    icon: '<path d="M3 20V7a1 1 0 0 1 1-1h3v14M3 20h18M7 20V6M11 20v-6a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v6M9 10h1M9 13h1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Transportation",
    tag: "Never rent one.",
    icon: '<path d="M5 16.5V13l1.6-4.3A2 2 0 0 1 8.5 7.5h7a2 2 0 0 1 1.9 1.2L19 13v3.5M5 16.5a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5M5 16.5H3M19 16.5a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5m4.5 0H21M7 13h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Food",
    tag: "Never expense it.",
    icon: '<path d="M6 3v7a2 2 0 0 0 4 0V3M8 10v11M17 3c-1.7 0-3 2-3 5s1.3 5 3 5v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---

<section id="pricing" class="bg-bg-soft px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p class="text-[13px] font-semibold uppercase tracking-wide text-navy">Pricing</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        One plan. No surprises.
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
        One flat rate for full directory access — no tiers to compare, no
        sales calls. If we ever raise the price, you keep the rate you signed
        up at.
      </p>
    </div>

    <div class="relative mx-auto mt-14 max-w-md">
      <span class="absolute -top-3 right-6 rounded-full bg-navy px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-lime">
        Price locked in
      </span>

      <div class="rounded-2xl bg-white p-8">
        <p class="text-[13px] font-semibold uppercase tracking-wide text-ink-faint">Full access</p>
        <p class="mt-2 flex items-baseline gap-1">
          <span class="font-display text-5xl font-extrabold text-ink">$50</span>
          <span class="text-[14px] text-ink-soft">/ 6 months</span>
        </p>
        <p class="mt-1.5 text-[13px] text-ink-soft">Billed every 6 months — your rate is locked in for as long as you stay subscribed.</p>

        <ul class="mt-6 flex flex-col gap-3">
          {
            included.map((item) => (
              <li class="flex items-start gap-2.5 text-[14px] text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="mt-0.5 shrink-0 text-navy" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>

        <p class="mt-5 text-[12.5px] leading-relaxed text-ink-faint">
          Billed every 6 months. Cancel anytime from your account — all sales
          are final and we don't offer refunds.
        </p>

        <a
          id="pricing-cta"
          href="/signup"
          class="mt-5 block rounded-xl bg-lime py-3.5 text-center text-[15px] font-semibold text-navy-dark transition-colors hover:bg-lime-dark"
        >
          Get full access
        </a>
      </div>
    </div>

    <script>
      // A signed-in visitor already has an account — sending them through
      // the signup form again would ask for a name/password they don't
      // need. Send them straight to where the actual Subscribe button
      // lives instead. isAuthenticated() is enough here (no need for the
      // async cookie-refresh check): if this tab isn't already signed in,
      // /signup is exactly right regardless of whether another tab is.
      import { isAuthenticated } from "../lib/session";
      const cta = document.querySelector<HTMLAnchorElement>("#pricing-cta");
      if (cta && isAuthenticated()) {
        cta.href = "/account/billing";
      }
    </script>

    <div class="mx-auto mt-8 max-w-2xl">
      <p class="text-center text-[13px] font-semibold uppercase tracking-wide text-ink-faint">
        What conference.contact replaces
      </p>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          savings.map((item) => (
            <div class="rounded-2xl bg-white p-4 text-center transition-transform hover:-translate-y-0.5">
              <span
                class="mx-auto grid h-11 w-11 place-items-center rounded-xl bg-lime-tint text-navy"
                set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none">${item.icon}</svg>`}
              />
              <p class="mt-3 text-[14px] font-bold text-ink">{item.label}</p>
              <p class="mt-0.5 text-[12px] text-ink-soft">{item.tag}</p>
              <p class="mt-2 font-display text-xl font-extrabold text-navy">$0</p>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-center text-[14px] leading-relaxed text-ink-soft">
        The contacts worth meeting are already here, in one place, waiting
        for you to pitch them or build a partnership.
      </p>
      <p class="mt-3 text-center text-[14px] leading-relaxed text-ink-soft">
        Land just one new client from the directory and it pays for itself
        many times over. We're not cutting corners to keep it cheap — a real
        team verifies every record by hand, every day.
      </p>
    </div>
  </div>
</section>
