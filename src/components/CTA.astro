---
import Wave from "./Wave.astro";
---

<section id="access" class="bg-bg-soft px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-[13px] font-semibold uppercase tracking-wide text-navy">Get started</p>
    <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
      Stop digging. Start searching.
    </h2>
    <p class="mx-auto mt-4 max-w-md text-[15px] leading-relaxed text-ink-soft">
      Sign up and you're searching the full directory in minutes — no sales
      call required.
    </p>

    <a
      href="/signup"
      class="mt-8 inline-block rounded-full bg-navy px-8 py-3.5 text-[14px] font-semibold text-white transition-colors hover:bg-navy-mid"
    >
      Get full access →
    </a>
  </div>
</section>
<Wave before="var(--color-bg-soft)" after="var(--color-navy)" />
