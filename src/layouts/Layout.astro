---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Auth-gated or otherwise non-public pages (account, admin, directory,
   * leads-finder, settings) opt into this — client-side auth checks don't
   * stop crawlers from indexing the page shell underneath them. */
  noindex?: boolean;
}

const {
  title = "conference.contact — The conference contact directory",
  description = "Search every speaker, sponsor, and attendee worth knowing across the B2B conference circuit. Verified emails, phone, and LinkedIn — ready to export.",
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-banner.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {!noindex && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "conference.contact",
        url: Astro.site?.toString(),
        description: "The verified conference contact directory for B2B affiliate, advertiser, and agency events.",
      })} />
    )}
  </head>
  <body class="font-body antialiased">
    <slot />
  </body>
</html>
